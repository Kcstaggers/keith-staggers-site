---
import Base from "../layouts/Base.astro";
import { publishedNotes } from "../data/notes";
import { site } from "../data/site";

const newsletterAction = `https://buttondown.com/api/emails/embed-subscribe/${site.newsletter.buttondownUsername}`;
const examples = [...publishedNotes].sort(
  (a, b) => b.datePublished.localeCompare(a.datePublished) || b.number.localeCompare(a.number)
);
const canonicalUrl = `${site.url}${site.newsletter.path}`;
const newsletterJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#page`,
      url: canonicalUrl,
      name: site.newsletter.name,
      description:
        "Practical emails from Keith Staggers about using AI at work, protecting human judgment, and finishing useful projects.",
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#keith` },
      mainEntity: { "@id": `${canonicalUrl}#examples` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#examples`,
      name: "Examples of what Keith writes about",
      numberOfItems: examples.length,
      itemListElement: examples.map((note, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: note.title,
        url: `${site.url}/notes/${note.slug}/`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
        { "@type": "ListItem", position: 2, name: site.newsletter.name, item: canonicalUrl },
      ],
    },
  ],
};
---

<Base
  title="The Frontline AI Brief Newsletter"
  description="Get practical emails from Keith Staggers about using AI at work, protecting human judgment, and finishing useful projects. At most two emails per month."
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(newsletterJsonLd)} />

  <article class="newsletter-page">
    <header class="newsletter-hero studio-shell">
      <nav class="newsletter-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Newsletter</span>
      </nav>

      <div class="newsletter-hero__grid">
        <div>
          <p class="studio-kicker">{site.newsletter.name}</p>
          <h1 class="studio-display">Practical AI ideas you can use at <strong>work</strong><span class="text-signal">.</span></h1>
        </div>
        <div class="newsletter-hero__copy">
          <p>Each email gives you one useful workflow, one guardrail, and one action you can take. The focus is real work, clear decisions, and finished results.</p>
          <p><strong>{site.newsletter.cadence}.</strong> No daily promotions and no automatic series.</p>
        </div>
      </div>
    </header>

    <section class="newsletter-signup studio-shell" aria-labelledby="newsletter-signup-title">
      <div class="newsletter-signup__promise">
        <p class="studio-kicker">Join the list</p>
        <h2 id="newsletter-signup-title" class="studio-display">Enter your email, then <strong>confirm it</strong><span class="text-signal">.</span></h2>
        <p>Buttondown manages the list. After you submit, Buttondown will email you a confirmation link. You are not subscribed unless you use that link.</p>
        <p>You can unsubscribe from any issue. Read the <a href={site.newsletter.privacyPath}>plain-language privacy notice</a> before joining.</p>
      </div>

      <form
        class="newsletter-form"
        action={newsletterAction}
        method="post"
        accept-charset="UTF-8"
        data-newsletter-form
        data-newsletter-placement="newsletter-page"
      >
        <input type="hidden" name="embed" value="1" />

        <label for="newsletter-subscribe-email">Email address</label>
        <input
          id="newsletter-subscribe-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          inputmode="email"
          placeholder="you@example.com"
          required
        />

        <label class="newsletter-consent" for="newsletter-subscribe-consent">
          <input
            id="newsletter-subscribe-consent"
            name="newsletter_consent"
            type="checkbox"
            value="I agree to receive The Frontline AI Brief through Buttondown"
            required
          />
          <span>I want {site.newsletter.name}. I agree that Buttondown may process my email to confirm and manage this subscription.</span>
        </label>

        <button type="submit">Send my confirmation email</button>
        <p class="newsletter-form__note">{site.newsletter.cadence}. Buttondown adds an unsubscribe link to every issue.</p>
      </form>
    </section>

    <section class="newsletter-examples studio-shell" aria-labelledby="newsletter-examples-title">
      <header>
        <p class="studio-kicker">Five public examples</p>
        <h2 id="newsletter-examples-title" class="studio-display">See what Keith writes about <strong>before</strong> you join<span class="text-signal">.</span></h2>
        <p>These published articles show the practical topics, plain language, and human-review standard the emails will follow.</p>
      </header>

      <ol>
        {examples.map((note, index) => (
          <li>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div>
              <p>{note.category} · {note.readingTime}</p>
              <h3><a href={`/notes/${note.slug}/`}>{note.title}</a></h3>
              <p>{note.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="newsletter-open studio-shell" aria-labelledby="newsletter-open-title">
      <div>
        <p class="studio-kicker">No resource gate</p>
        <h2 id="newsletter-open-title">The free tools stay free whether you subscribe or not.</h2>
      </div>
      <div>
        <a href="/workflow-book/">Use the ten free book-companion templates</a>
        <a href="/workflow-testing-template/">Use the 10-example process testing worksheet</a>
      </div>
    </section>
  </article>
</Base>

<style>
  .newsletter-page {
    overflow: clip;
    background:
      radial-gradient(circle at 86% 5%, rgb(40 81 255 / 0.18), transparent 28rem),
      linear-gradient(90deg, rgb(40 81 255 / 0.045) 1px, transparent 1px),
      var(--color-ink);
    background-size: auto, 72px 72px, auto;
  }

  .newsletter-hero,
  .newsletter-signup,
  .newsletter-examples,
  .newsletter-open {
    padding-block: clamp(3.5rem, 8vw, 7.5rem);
  }

  .newsletter-breadcrumb {
    display: flex;
    gap: 0.7rem;
    color: var(--color-paper-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .newsletter-breadcrumb a:hover,
  .newsletter-breadcrumb a:focus-visible,
  .newsletter-signup a:hover,
  .newsletter-signup a:focus-visible {
    color: var(--color-paper);
  }

  .newsletter-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    margin-top: clamp(3rem, 7vw, 6.5rem);
  }

  .newsletter-hero h1 {
    max-width: 13ch;
    margin-top: 1.2rem;
    font-size: clamp(3.8rem, 7vw, 6.5rem);
    line-height: 0.86;
  }

  .newsletter-hero h1 strong,
  .newsletter-signup h2 strong,
  .newsletter-examples h2 strong {
    color: var(--color-cobalt);
    font-weight: inherit;
  }

  .newsletter-hero__copy,
  .newsletter-signup__promise,
  .newsletter-examples header {
    color: var(--color-paper-dim);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.75;
  }

  .newsletter-hero__copy {
    display: grid;
    gap: 1.2rem;
  }

  .newsletter-hero__copy strong {
    color: var(--color-paper);
  }

  .newsletter-signup {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 0.65fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .newsletter-signup__promise {
    display: grid;
    align-content: start;
    gap: 1.2rem;
  }

  .newsletter-signup h2 {
    max-width: 15ch;
    color: var(--color-paper);
    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 0.95;
  }

  .newsletter-signup a {
    color: var(--color-cobalt-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .newsletter-form {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--color-rule);
    background: rgb(10 12 18 / 0.88);
  }

  .newsletter-form > label:first-of-type {
    font-size: 0.85rem;
    font-weight: 700;
  }

  .newsletter-form > input[type="email"] {
    width: 100%;
    min-height: 3.4rem;
    padding-inline: 1rem;
    border: 1px solid var(--color-rule);
    color: var(--color-paper);
    background: var(--color-ink);
  }

  .newsletter-form > input[type="email"]:focus {
    border-color: var(--color-cobalt);
    outline: 2px solid color-mix(in srgb, var(--color-cobalt) 45%, transparent);
    outline-offset: 2px;
  }

  .newsletter-consent {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    color: var(--color-paper-dim);
    font-size: 0.83rem;
    line-height: 1.6;
  }

  .newsletter-consent input {
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.18rem;
    accent-color: var(--color-cobalt);
  }

  .newsletter-form button {
    min-height: 3.5rem;
    padding: 0.85rem 1.1rem;
    border: 0;
    color: var(--color-ink);
    background: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .newsletter-form button:hover,
  .newsletter-form button:focus-visible {
    background: var(--color-paper);
  }

  .newsletter-form button:focus-visible {
    outline: 3px solid var(--color-cobalt);
    outline-offset: 3px;
  }

  .newsletter-form__note {
    color: var(--color-paper-faint);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .newsletter-examples header {
    max-width: 54rem;
  }

  .newsletter-examples h2 {
    margin-block: 1.2rem;
    color: var(--color-paper);
    font-size: clamp(2.6rem, 5.6vw, 5.7rem);
    line-height: 0.95;
  }

  .newsletter-examples ol {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid var(--color-rule);
  }

  .newsletter-examples li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--color-rule);
  }

  .newsletter-examples li > span,
  .newsletter-examples li > div > p:first-child {
    color: var(--color-paper-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .newsletter-examples li > div {
    display: grid;
    gap: 0.75rem;
  }

  .newsletter-examples h3 {
    max-width: 34ch;
    font-size: clamp(1.35rem, 2.5vw, 2.2rem);
    line-height: 1.12;
  }

  .newsletter-examples h3 a:hover,
  .newsletter-examples h3 a:focus-visible {
    color: var(--color-cobalt-text);
  }

  .newsletter-examples li > div > p:last-child {
    max-width: 54rem;
    color: var(--color-paper-dim);
    line-height: 1.7;
  }

  .newsletter-open {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    border-top: 1px solid var(--color-rule);
  }

  .newsletter-open h2 {
    max-width: 24ch;
    margin-top: 1rem;
    font-size: clamp(2rem, 4vw, 3.8rem);
    line-height: 1;
  }

  .newsletter-open > div:last-child {
    display: grid;
    gap: 1px;
    background: var(--color-rule);
  }

  .newsletter-open a {
    padding: 1.1rem;
    color: var(--color-paper);
    background: var(--color-panel);
  }

  .newsletter-open a:hover,
  .newsletter-open a:focus-visible {
    color: var(--color-ink);
    background: var(--color-paper);
  }

  @media (max-width: 820px) {
    .newsletter-hero__grid,
    .newsletter-signup,
    .newsletter-open {
      grid-template-columns: minmax(0, 1fr);
    }

    .newsletter-hero__copy,
    .newsletter-signup__promise,
    .newsletter-examples header {
      max-width: 42rem;
    }
  }

  @media (max-width: 520px) {
    .newsletter-hero h1 {
      font-size: clamp(3.35rem, 18vw, 5.25rem);
    }

    .newsletter-examples li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.8rem;
    }
  }
</style>
