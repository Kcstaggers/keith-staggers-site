---
import Base from "../layouts/Base.astro";
import { formConfigured, formEndpoint } from "../data/forms";
import { site } from "../data/site";

const projectFitJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${site.url}/project-fit/#page`,
      name: "Tell Keith What You Need Help With",
      description:
        "Tell Keith Staggers which task or project is taking too much time, what you want instead, and when you need help.",
      url: `${site.url}/project-fit/`,
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${site.url}/project-fit/#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Tell Keith About Your Task",
          item: `${site.url}/project-fit/`,
        },
      ],
    },
  ],
};
---

<Base
  title="Tell Keith What You Need Help With"
  description="Tell Keith Staggers which task or project is taking too much time, what you want instead, and when you need help."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(projectFitJsonLd)} />
  </Fragment>

  <section class="project-fit" aria-labelledby="project-fit-title">
    <div class="studio-shell project-fit-shell">
      <nav class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-paper">Home</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <span class="text-cobalt-text" aria-current="page">Tell Keith About Your Task</span>
      </nav>

      <header class="project-fit-head">
        <div>
          <p class="studio-kicker">Start here</p>
          <h1 id="project-fit-title" class="studio-display">
            What do you want<br />to make <strong>easier</strong><span class="text-signal">?</span>
          </h1>
        </div>
        <div class="project-fit-intro">
          <p>You do not need a technical explanation. Tell me what happens now, what is taking too much time, and what you want instead. I review every inquiry before sharing a private booking link.</p>
          <a href="/workflow-readiness/">Not sure AI is right for the task? Take the free five-minute check →</a>
        </div>
      </header>

      <ol class="project-fit-steps" aria-label="How the project fit process works">
        <li><span>01</span><b>Describe the task</b><p>Tell Keith what is happening now and what you want instead.</p></li>
        <li><span>02</span><b>Keith reviews it</b><p>Your inquiry goes privately to Keith so he can recommend the right next step.</p></li>
        <li><span>03</span><b>You hear back</b><p>If a conversation makes sense, Keith replies with a private calendar link.</p></li>
      </ol>

      <div class="project-fit-grid">
        <aside class="project-fit-aside">
          <p class="studio-kicker">Helpful information to include</p>
          <ul>
            <li>The task or project that is taking too much time.</li>
            <li>What you want to happen instead.</li>
            <li>Who will use the result.</li>
            <li>When you need help and the budget range that fits.</li>
          </ul>
          <p class="project-fit-privacy">Your details are used only to evaluate and reply to this inquiry. Do not include protected health information, confidential employer or client data, passwords, or API keys.</p>
        </aside>

        <form
          class="project-fit-form"
          data-project-fit-form
          data-form-configured={String(formConfigured)}
          action={formEndpoint || undefined}
          method="post"
          accept-charset="UTF-8"
        >
          <input type="hidden" name="subject" value="[KS Project Fit] {{ email }}" />
          <input type="hidden" name="form_type" value="Project Fit" />
          <input type="hidden" name="inquiry_marker" value="ks-project-fit-v1" />
          <input type="hidden" name="source_page" value="/project-fit/" />

          <div class="form-honeypot" aria-hidden="true">
            <label for="fit-company-site">Leave this field empty</label>
            <input id="fit-company-site" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="fit-field fit-field--half">
            <label for="fit-name">Your name</label>
            <input id="fit-name" name="name" type="text" autocomplete="name" maxlength="120" required />
          </div>

          <div class="fit-field fit-field--half">
            <label for="fit-email">Your email</label>
            <input id="fit-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>

          <div class="fit-field">
            <label for="fit-role">Organization and your role</label>
            <input id="fit-role" name="role" type="text" autocomplete="organization-title" maxlength="180" placeholder="Company, team, or independent project" required />
          </div>

          <div class="fit-field fit-field--half">
            <label for="fit-need">How can Keith help?</label>
            <select id="fit-need" name="need" required>
              <option value="">Choose one</option>
              <option value="done-for-you">Build a solution for one repetitive task</option>
              <option value="one-to-one">Help me solve one problem</option>
              <option value="training">Train my team</option>
              <option value="speaking">Speak at my event</option>
              <option value="employment">Employment or recruiter conversation</option>
              <option value="not-sure">I am not sure yet</option>
            </select>
          </div>

          <div class="fit-field fit-field--half">
            <label for="fit-timeline">When do you need help?</label>
            <select id="fit-timeline" name="timeline" required>
              <option value="">Choose one</option>
              <option>Within 30 days</option>
              <option>Within 1 to 3 months</option>
              <option>Within 3 to 6 months</option>
              <option>Exploring with no date yet</option>
            </select>
          </div>

          <div class="fit-field">
            <label for="fit-tried">What task takes too much time or keeps getting stuck?</label>
            <textarea id="fit-tried" name="tried" rows="5" minlength="20" maxlength="1600" placeholder="Describe what happens now in ordinary words. You do not need to know the technical solution." required></textarea>
          </div>

          <div class="fit-field">
            <label for="fit-outcome">What should happen when it works?</label>
            <textarea id="fit-outcome" name="outcome" rows="5" minlength="40" maxlength="2000" placeholder="Describe the result you want and who will use it." required></textarea>
          </div>

          <div class="fit-field" data-build-only hidden>
            <label for="fit-input">What information starts this task, and where is it now?</label>
            <textarea id="fit-input" name="input" rows="3" minlength="20" maxlength="1200" placeholder="For example: notes in email, a spreadsheet, a form, or a document folder."></textarea>
          </div>

          <div class="fit-field" data-build-only hidden>
            <label for="fit-approval">Who checks the result before it is used or sent?</label>
            <input id="fit-approval" name="approval" type="text" minlength="5" maxlength="300" placeholder="Name the role, even if that person is you." />
          </div>

          <div class="fit-field fit-field--half">
            <label for="fit-investment">Which budget range fits?</label>
            <select id="fit-investment" name="investment" required>
              <option value="">Choose one</option>
              <option>Employment or recruiter discussion</option>
              <option>$250 one-to-one working session</option>
              <option>$2,500+ done-for-you AI setup</option>
              <option>$3,500+ team training or speaking</option>
              <option>$5,000+ larger AI or production project</option>
              <option>I need guidance before choosing</option>
            </select>
          </div>

          <div class="fit-field fit-field--half">
            <label for="fit-link">Website or profile</label>
            <input id="fit-link" name="link" type="url" inputmode="url" maxlength="500" placeholder="https://" />
          </div>

          <label class="fit-confirm" for="fit-confirm">
            <input id="fit-confirm" name="confidentiality_confirmed" type="checkbox" value="Confirmed" required />
            <span>I confirm this contains no protected, confidential, or credential information.</span>
          </label>

          <label class="fit-confirm" for="fit-consent">
            <input id="fit-consent" name="contact_consent" type="checkbox" value="Consented" required />
            <span>I consent to Keith using the contact details above to evaluate and reply to this inquiry.</span>
          </label>

          <p
            class="form-status"
            data-fit-status
            data-state={formConfigured ? "ready" : "error"}
            aria-live="polite"
          >
            {formConfigured
              ? "Your inquiry will be sent through Formspree to Keith's private inbox."
              : "Inquiry delivery is not configured yet. The form will not send."}
          </p>

          <button class="studio-button studio-button--primary fit-submit" type="submit" disabled={!formConfigured}>
            <span data-submit-label>Send Keith my project</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </form>
      </div>

      <section class="project-fit-review" data-fit-success hidden tabindex="-1" aria-labelledby="fit-success-title">
        <p class="studio-kicker">Sent securely</p>
        <h2 id="fit-success-title" class="studio-display">Inquiry received<span class="text-signal">.</span></h2>
        <p>Keith will review what you sent. If there is a useful next step, he will reply to the email you provided and share a private calendar link when a conversation makes sense.</p>
        <div class="project-fit-review-actions">
          <a class="studio-button studio-button--secondary" href="/">Back to the homepage</a>
          <a class="studio-button studio-button--secondary" href="/workflow-readiness/">Check another task</a>
        </div>
      </section>
    </div>
  </section>
</Base>

<script>
  const fitForm = document.querySelector<HTMLFormElement>("[data-project-fit-form]");
  const fitStatus = document.querySelector<HTMLElement>("[data-fit-status]");
  const fitSuccess = document.querySelector<HTMLElement>("[data-fit-success]");
  const fitSubmit = fitForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const fitSubmitLabel = fitForm?.querySelector<HTMLElement>("[data-submit-label]");
  const fitNeed = fitForm?.querySelector<HTMLSelectElement>("#fit-need");
  const buildOnlyFields = Array.from(fitForm?.querySelectorAll<HTMLElement>("[data-build-only]") ?? []);

  const updateBuildQuestions = () => {
    const show = fitNeed?.value === "done-for-you";
    buildOnlyFields.forEach((field) => {
      field.hidden = !show;
      field.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea").forEach((input) => {
        input.required = Boolean(show);
      });
    });
  };

  fitNeed?.addEventListener("change", updateBuildQuestions);
  updateBuildQuestions();

  fitForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!fitForm.reportValidity() || !fitStatus || !fitSubmit || !fitSubmitLabel) return;

    const configured = fitForm.dataset.formConfigured === "true";
    const endpoint = fitForm.getAttribute("action");
    if (!configured || !endpoint) {
      fitStatus.dataset.state = "error";
      fitStatus.textContent = "Inquiry delivery is not configured. Nothing was sent.";
      return;
    }

    fitForm.setAttribute("aria-busy", "true");
    fitSubmit.disabled = true;
    fitSubmitLabel.textContent = "Sending...";
    fitStatus.dataset.state = "ready";
    fitStatus.textContent = "Sending your inquiry...";

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        body: new FormData(fitForm),
        headers: { Accept: "application/json" },
      });

      if (!response.ok) throw new Error("Form submission failed");

      fitForm.reset();
      fitForm.hidden = true;
      if (fitSuccess) {
        fitSuccess.hidden = false;
        fitSuccess.focus();
      }
    } catch {
      fitStatus.dataset.state = "error";
      fitStatus.textContent = "That did not send. Check your connection and try again. Your answers are still on this page.";
      fitSubmit.disabled = false;
      fitSubmitLabel.textContent = "Send Keith my project";
    } finally {
      fitForm.removeAttribute("aria-busy");
    }
  });
</script>
