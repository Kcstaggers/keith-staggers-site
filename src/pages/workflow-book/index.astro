---
import Base from "../../layouts/Base.astro";
import { site } from "../../data/site";
import {
  workflowBookCompanion,
  workflowBookTemplates,
} from "../../data/workflow-book";

const canonicalUrl = `${site.url}${workflowBookCompanion.route}`;
const templateUrl = (fileName: string) =>
  `${site.url}/workflow-book/templates/${fileName}`;
const faqs = [
  {
    question: "Is the book available now?",
    answer:
      "The book is forthcoming. This page is its living companion resource and the templates can be used independently before the retail release.",
  },
  {
    question: "Why keep the templates outside the book?",
    answer:
      "The book holds the durable operating principles. These files can be corrected, versioned, and expanded without making the printed explanation depend on a specific AI tool or interface.",
  },
  {
    question: "Do these templates require a specific AI product?",
    answer:
      "No. They are plain Markdown files built around sources, boundaries, approvals, finish lines, testing, evidence, and recovery. Adapt them to the tools and policies that apply to your work.",
  },
  {
    question: "Does this page collect the information I put in the templates?",
    answer:
      "No. The links download blank files. Complete and store them in a workspace you control. Do not place credentials, protected information, or material you lack permission to use in an AI-assisted system.",
  },
  {
    question: "Do the templates make an AI workflow secure or compliant?",
    answer:
      "No. They help make decisions and failure handling visible. You remain responsible for the laws, contracts, privacy rules, professional duties, account controls, and human review that apply to your work.",
  },
];
const companionJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#page`,
      name: "AI Workflow Book Companion Templates",
      description: workflowBookCompanion.description,
      url: canonicalUrl,
      dateModified: workflowBookCompanion.dateModified,
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
      about: [
        "AI operating workspace",
        "human approval gates",
        "AI workflow testing",
        "workflow recovery",
      ],
      mainEntity: { "@id": `${canonicalUrl}#companion` },
      author: { "@id": `${site.url}/#keith` },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    {
      "@type": "LearningResource",
      "@id": `${canonicalUrl}#companion`,
      name: "AI Workflow Book Companion",
      description: workflowBookCompanion.description,
      url: canonicalUrl,
      author: { "@id": `${site.url}/#keith` },
      creator: { "@id": `${site.url}/#keith` },
      publisher: { "@id": `${site.url}/#studio` },
      dateModified: workflowBookCompanion.dateModified,
      inLanguage: "en-US",
      learningResourceType: "Template collection",
      educationalUse: "Build and test a controlled AI-assisted workflow",
      isAccessibleForFree: true,
      hasPart: workflowBookTemplates.map((template) => ({
        "@type": "LearningResource",
        "@id": `${canonicalUrl}#${template.slug}`,
        name: `${template.number}. ${template.title}`,
        description: template.purpose,
        learningResourceType: "Markdown template",
        encodingFormat: "text/markdown",
        isAccessibleForFree: true,
        contentUrl: templateUrl(template.fileName),
      })),
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#templates`,
      name: "Ten AI workflow companion templates",
      numberOfItems: workflowBookTemplates.length,
      itemListElement: workflowBookTemplates.map((template, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `${canonicalUrl}#${template.slug}`,
        item: { "@id": `${canonicalUrl}#${template.slug}` },
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Books",
          item: `${site.url}/books/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "AI Workflow Book Companion",
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Base
  title="AI Workflow Book Companion Templates"
  description={workflowBookCompanion.description}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(companionJsonLd)}
    />
  </Fragment>

  <article class="px-6 pb-20 pt-10 lg:px-12 lg:pb-28 lg:pt-16">
    <div class="mx-auto max-w-[1280px]">
      <nav
        class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint"
        aria-label="Breadcrumb"
      >
        <a href="/" class="transition-colors hover:text-paper">Home</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <a href="/books/" class="transition-colors hover:text-paper">Books</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <span class="text-cobalt-text" aria-current="page">Workflow book companion</span>
      </nav>

      <header class="grid gap-10 border-b border-rule pb-14 lg:grid-cols-12 lg:items-end lg:pb-20">
        <div class="lg:col-span-8">
          <h1 class="studio-display text-[clamp(52px,8vw,108px)] leading-[0.88]">
            The book stays durable<span class="text-signal">.</span><br />
            <strong>The tools stay current.</strong>
          </h1>
        </div>
        <div class="lg:col-span-4">
          <p class="text-[18px] leading-[1.7] text-paper-dim">
            Ten practical Markdown templates for building a controlled AI operating workspace with current truth, human gates, testing, proof, and recovery.
          </p>
          <p class="mt-5 font-mono text-[11px] leading-[1.7] tracking-[0.12em] uppercase text-paper-faint">
            Forthcoming book companion · Free · No email gate
          </p>
        </div>
      </header>

      <section
        class="grid gap-8 border-b border-rule py-12 lg:grid-cols-12 lg:py-16"
        aria-labelledby="direct-answer-title"
      >
        <div class="lg:col-span-4">
          <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
            Direct answer
          </p>
          <h2
            id="direct-answer-title"
            class="studio-display mt-4 text-[clamp(34px,4vw,52px)] leading-[1]"
          >
            What is the <strong>living companion?</strong>
          </h2>
        </div>
        <div class="space-y-5 text-[16px] leading-[1.75] text-paper-dim lg:col-span-8">
          <p>
            This is the companion resource for Keith Staggers's forthcoming field guide to controlled AI workflows. The book explains the durable decisions. These files give you an editable starting point and can change as better practices emerge.
          </p>
          <p>
            Start with the first six files to create one operating workspace. Then define one repeated job, test ten normal and failure cases, set authority by consequence, and prove that another operator can stop and recover the system.
          </p>
          <p>
            The files do not make a workflow secure, compliant, or correct by themselves. Use only material you own or are allowed to use, and keep money, identity, binding commitments, professional judgment, and sensitive information behind the appropriate human decision.
          </p>
        </div>
      </section>

      <section
        class="grid gap-px border-b border-rule bg-rule/70 sm:grid-cols-3"
        aria-label="Companion workflow"
      >
        <div class="bg-ink p-6 lg:p-8">
          <span class="font-mono text-[10px] tracking-[0.16em] text-cobalt-text">01 · ORIENT</span>
          <h2 class="mt-4 text-xl font-semibold">Make the work legible</h2>
          <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">Write stable context, current state, and a short queue without mixing plans with proof.</p>
        </div>
        <div class="bg-ink p-6 lg:p-8">
          <span class="font-mono text-[10px] tracking-[0.16em] text-cobalt-text">02 · CONTROL</span>
          <h2 class="mt-4 text-xl font-semibold">Put consequences behind gates</h2>
          <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">Define what AI may do, what it may prepare, and what the responsible human must decide.</p>
        </div>
        <div class="bg-ink p-6 lg:p-8">
          <span class="font-mono text-[10px] tracking-[0.16em] text-cobalt-text">03 · PROVE</span>
          <h2 class="mt-4 text-xl font-semibold">Test, record, transfer, recover</h2>
          <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">Use observable finish lines and failure cases before depending on the workflow.</p>
        </div>
      </section>

      <section class="py-14 lg:py-20" aria-labelledby="templates-title">
        <header class="grid gap-7 border-b border-rule pb-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
              Companion version {workflowBookCompanion.version}
            </p>
            <h2
              id="templates-title"
              class="studio-display mt-4 text-[clamp(42px,6vw,82px)] leading-[0.94]"
            >
              Ten files<span class="text-signal">.</span><br /><strong>One controlled workspace.</strong>
            </h2>
          </div>
          <div class="lg:col-span-4">
            <p class="text-[15px] leading-[1.7] text-paper-dim">
              Plain text travels well. Download each file, complete only what you know, and mark unread facts <code class="text-paper">UNKNOWN</code>.
            </p>
            <p class="mt-4 font-mono text-[10px] tracking-[0.12em] uppercase text-paper-faint">
              Version {workflowBookCompanion.version} · Updated July 30, 2026
            </p>
          </div>
        </header>

        <ol class="divide-y divide-rule">
          {workflowBookTemplates.map((template) => (
            <li
              id={template.slug}
              class="grid gap-6 py-9 sm:grid-cols-[4rem_1fr] lg:grid-cols-[5rem_1fr_auto] lg:items-center"
            >
              <span class="font-mono text-[12px] tracking-[0.16em] text-cobalt-text">
                {template.number}
              </span>
              <div>
                <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-paper-faint">
                  {template.stage}
                </p>
                <h3 class="studio-display mt-2 text-[clamp(28px,3vw,42px)] leading-tight">
                  {template.title}
                </h3>
                <p class="mt-3 max-w-[760px] text-[15px] leading-[1.7] text-paper-dim">
                  {template.purpose}
                </p>
              </div>
              <a
                href={`/workflow-book/templates/${template.fileName}`}
                download={template.fileName}
                class="studio-button studio-button--secondary sm:col-start-2 lg:col-start-auto"
                data-workflow-book-download={template.slug}
                data-workflow-book-placement="template-list"
              >
                Download .md
              </a>
            </li>
          ))}
        </ol>

        <div class="flex flex-wrap items-center gap-4 border-t border-rule pt-8">
          <a
            href="/workflow-testing-template/"
            class="studio-button studio-button--cobalt"
            data-workflow-template-action="companion-browser-test"
          >
            Use the browser-based Ten-Case Test
          </a>
          <p class="max-w-xl text-sm leading-[1.7] text-paper-faint">
            The browser worksheet saves locally, exports CSV, and prints to PDF. Use synthetic or approved data only.
          </p>
        </div>
      </section>

      <section
        class="grid gap-8 border-y border-rule py-12 lg:grid-cols-12 lg:py-16"
        aria-labelledby="versioning-title"
      >
        <div class="lg:col-span-4">
          <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
            Durable core · Living layer
          </p>
          <h2
            id="versioning-title"
            class="studio-display mt-4 text-[clamp(34px,4vw,52px)] leading-[1]"
          >
            Why the system is <strong>split in two.</strong>
          </h2>
        </div>
        <div class="grid gap-px bg-rule/70 sm:grid-cols-2 lg:col-span-8">
          <div class="bg-ink p-6">
            <h3 class="text-lg font-semibold">The durable book</h3>
            <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">
              Sources, decision rights, workflow contracts, finish lines, testing, evidence, recovery, and transfer. The ideas should remain useful across tools.
            </p>
          </div>
          <div class="bg-ink p-6">
            <h3 class="text-lg font-semibold">The living companion</h3>
            <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">
              Editable templates, corrections, dated versions, and implementation notes. This layer can improve without rewriting the durable argument.
            </p>
          </div>
        </div>
      </section>

      <section class="py-14 lg:py-20" aria-labelledby="faq-title">
        <header class="border-b border-rule pb-8">
          <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
            Before you download
          </p>
          <h2
            id="faq-title"
            class="studio-display mt-4 text-[clamp(42px,6vw,76px)] leading-[0.94]"
          >
            Straight <strong>answers.</strong>
          </h2>
        </header>
        <div class="divide-y divide-rule">
          {faqs.map((faq) => (
            <details class="group py-7">
              <summary class="cursor-pointer list-none pr-8 text-lg font-semibold marker:hidden">
                {faq.question}
              </summary>
              <p class="mt-4 max-w-[860px] text-[15px] leading-[1.75] text-paper-dim">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <section class="grid items-end gap-10 border-t border-rule pt-16 lg:grid-cols-12 lg:pt-24">
        <div class="lg:col-span-8">
          <h2 class="studio-display text-[clamp(40px,5.5vw,76px)] leading-[0.96]">
            Build one useful workflow<span class="text-signal">.</span><br />
            <strong>Keep the consequential judgment.</strong>
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
          <a href="/books/" class="studio-button studio-button--secondary">See Keith's current books</a>
          <a href="/services/training/" class="studio-button studio-button--secondary">Explore practical AI training</a>
        </div>
      </section>
    </div>
  </article>
</Base>
