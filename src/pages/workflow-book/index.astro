---
import Base from "../../layouts/Base.astro";
import { books, liveEditionsFor } from "../../data/books";
import { site } from "../../data/site";
import {
  workflowBookCompanion,
  workflowBookTemplates,
} from "../../data/workflow-book";

const canonicalUrl = `${site.url}${workflowBookCompanion.route}`;
const workflowBook = books.find(
  (book) => book.slug === "build-the-workflow-keep-the-judgment"
);
if (!workflowBook) throw new Error("Build the Workflow book record is missing");
const kindleEdition = liveEditionsFor(workflowBook).find(
  (edition) => edition.format === "Kindle"
);
if (!kindleEdition) throw new Error("Build the Workflow Kindle record is missing");
const workflowBookUrl = `${site.url}/books/${workflowBook.slug}/`;
const templateUrl = (fileName: string) =>
  `${site.url}/workflow-book/templates/${fileName}`;
const faqs = [
  {
    question: "Is the book available now?",
    answer:
      "Yes. The Kindle edition is available on Amazon for $9.99. The paperback is published in KDP at $17.99, and its United States Amazon page is still propagating. These free templates can also be used on their own.",
  },
  {
    question: "Why keep the templates outside the book?",
    answer:
      "The book explains decisions that should remain useful over time. The downloadable files can be corrected and improved as AI tools change.",
  },
  {
    question: "Do these templates require a specific AI product?",
    answer:
      "No. They are simple text files for recording sources, limits, approvals, a good result, tests, evidence, and what to do after a failure. Adapt them to the rules that apply to your work.",
  },
  {
    question: "Does this page collect the information I put in the templates?",
    answer:
      "No. The links download blank text files. Complete and store them in a folder or app you control. Do not place passwords, protected information, or material you lack permission to use in an AI tool or process.",
  },
  {
    question: "Do the templates make an AI workflow secure or compliant?",
    answer:
      "No. They help make decisions, approvals, and failure steps visible. You remain responsible for the laws, contracts, privacy rules, professional duties, account controls, and human review that apply to your work.",
  },
];
const companionJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#page`,
      name: "Ten Free Templates for Organizing AI Work",
      description: workflowBookCompanion.description,
      url: canonicalUrl,
      dateModified: workflowBookCompanion.dateModified,
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
      about: [
        "AI operating workspace",
        "human approval gates",
        "AI workflow testing",
        "workflow recovery",
      ],
      mainEntity: { "@id": `${canonicalUrl}#companion` },
      author: { "@id": `${site.url}/#keith` },
      breadcrumb: { "@id": `${canonicalUrl}#breadcrumb` },
    },
    {
      "@type": "LearningResource",
      "@id": `${canonicalUrl}#companion`,
      name: "Free AI Work Templates by Keith Staggers",
      description: workflowBookCompanion.description,
      url: canonicalUrl,
      author: { "@id": `${site.url}/#keith` },
      creator: { "@id": `${site.url}/#keith` },
      publisher: { "@id": `${site.url}/#studio` },
      dateModified: workflowBookCompanion.dateModified,
      inLanguage: "en-US",
      learningResourceType: "Template collection",
      educationalUse: "Organize and test an AI-assisted work process",
      isAccessibleForFree: true,
      isPartOf: { "@id": `${workflowBookUrl}#book` },
      hasPart: workflowBookTemplates.map((template) => ({
        "@type": "LearningResource",
        "@id": `${canonicalUrl}#${template.slug}`,
        name: `${template.number}. ${template.title}`,
        description: template.purpose,
        learningResourceType: "Markdown template",
        encodingFormat: "text/markdown",
        isAccessibleForFree: true,
        contentUrl: templateUrl(template.fileName),
      })),
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#templates`,
      name: "Ten free templates for organizing AI work",
      numberOfItems: workflowBookTemplates.length,
      itemListElement: workflowBookTemplates.map((template, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `${canonicalUrl}#${template.slug}`,
        item: { "@id": `${canonicalUrl}#${template.slug}` },
      })),
    },
    {
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Books",
          item: `${site.url}/books/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: "Free AI Work Templates",
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Base
  title="Ten Free Templates for Organizing AI Work"
  description={workflowBookCompanion.description}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(companionJsonLd)}
    />
  </Fragment>

  <article class="px-6 pb-20 pt-10 lg:px-12 lg:pb-28 lg:pt-16">
    <div class="mx-auto max-w-[1280px]">
      <nav
        class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint"
        aria-label="Breadcrumb"
      >
        <a href="/" class="transition-colors hover:text-paper">Home</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <a href="/books/" class="transition-colors hover:text-paper">Books</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <span class="text-cobalt-text" aria-current="page">Free AI work templates</span>
      </nav>

      <header class="grid gap-10 border-b border-rule pb-14 lg:grid-cols-12 lg:items-end lg:pb-20">
        <div class="lg:col-span-8">
          <h1 class="studio-display text-[clamp(52px,8vw,108px)] leading-[0.88]">
            Ten free templates<br />for organizing <strong>AI work</strong><span class="text-signal">.</span>
          </h1>
        </div>
        <div class="lg:col-span-4">
          <p class="text-[18px] leading-[1.7] text-paper-dim">
            Download ten simple text files for organizing priorities, setting approval rules, testing repeated tasks, recording evidence, and explaining what to do when something fails.
          </p>
          <p class="mt-5 font-mono text-[11px] leading-[1.7] tracking-[0.12em] uppercase text-paper-faint">
            Companion to Build the Workflow. Keep the Judgment. · Free · No email required
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={`/books/${workflowBook.slug}/`} class="studio-button studio-button--secondary">Read about the book</a>
            <a
              href={kindleEdition.ownedSiteAttributionUrl ?? kindleEdition.amazonUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="studio-button studio-button--cobalt"
              data-amazon-book={workflowBook.slug}
              data-amazon-format="kindle"
              data-amazon-placement="workflow-companion-hero"
              data-amazon-attribution={kindleEdition.ownedSiteAttributionUrl ? "book-site-organic" : "unattributed"}
            >Buy the Kindle · $9.99</a>
          </div>
        </div>
      </header>

      <section
        class="grid gap-8 border-b border-rule py-12 lg:grid-cols-12 lg:py-16"
        aria-labelledby="direct-answer-title"
      >
        <div class="lg:col-span-4">
          <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
            Plain-English overview
          </p>
          <h2
            id="direct-answer-title"
            class="studio-display mt-4 text-[clamp(34px,4vw,52px)] leading-[1]"
          >
            What do these files <strong>help you do?</strong>
          </h2>
        </div>
        <div class="space-y-5 text-[16px] leading-[1.75] text-paper-dim lg:col-span-8">
          <p>
            These files help one person or a small team keep AI work organized. They record the current priority, the rules AI must follow, the tasks in progress, who approves important actions, and the evidence showing what actually happened.
          </p>
          <p>
            Start with the first six files to organize the work. Then describe one repeated task, test it with ten normal and failure examples, decide which actions require approval, and make sure another person can use it and handle a problem.
          </p>
          <p>
            The files do not make an AI process safe, legal, or correct by themselves. Use only information you own or are allowed to use. A responsible person must approve money, identity, contracts, professional decisions, and sensitive information.
          </p>
        </div>
      </section>

      <section
        class="grid gap-px border-b border-rule bg-rule/70 sm:grid-cols-3"
        aria-label="Three jobs the templates help with"
      >
        <div class="bg-ink p-6 lg:p-8">
          <span class="font-mono text-[10px] tracking-[0.16em] text-cobalt-text">01 · UNDERSTAND</span>
          <h2 class="mt-4 text-xl font-semibold">Make the work easy to understand</h2>
          <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">Write down what matters now, what is in progress, and which facts are confirmed.</p>
        </div>
        <div class="bg-ink p-6 lg:p-8">
          <span class="font-mono text-[10px] tracking-[0.16em] text-cobalt-text">02 · SET RULES</span>
          <h2 class="mt-4 text-xl font-semibold">Decide what needs approval</h2>
          <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">Write down what AI may do, what it may prepare, and what a responsible person must decide.</p>
        </div>
        <div class="bg-ink p-6 lg:p-8">
          <span class="font-mono text-[10px] tracking-[0.16em] text-cobalt-text">03 · TEST</span>
          <h2 class="mt-4 text-xl font-semibold">Test the process and prepare for failure</h2>
          <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">Test a clear result and common failures before depending on the process.</p>
        </div>
      </section>

      <section class="py-14 lg:py-20" aria-labelledby="templates-title">
        <header class="grid gap-7 border-b border-rule pb-10 lg:grid-cols-12 lg:items-end">
          <div class="lg:col-span-8">
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
              Companion version {workflowBookCompanion.version}
            </p>
            <h2
              id="templates-title"
              class="studio-display mt-4 text-[clamp(42px,6vw,82px)] leading-[0.94]"
            >
              Ten files<span class="text-signal">.</span><br /><strong>One organized workspace.</strong>
            </h2>
          </div>
          <div class="lg:col-span-4">
            <p class="text-[15px] leading-[1.7] text-paper-dim">
              These are simple text files. Download each one, complete only what you know, and mark anything you have not verified as <code class="text-paper">UNKNOWN</code>.
            </p>
            <p class="mt-4 font-mono text-[10px] tracking-[0.12em] uppercase text-paper-faint">
              Version {workflowBookCompanion.version} · Updated July 30, 2026
            </p>
          </div>
        </header>

        <ol class="divide-y divide-rule">
          {workflowBookTemplates.map((template) => (
            <li
              id={template.slug}
              class="grid gap-6 py-9 sm:grid-cols-[4rem_1fr] lg:grid-cols-[5rem_1fr_auto] lg:items-center"
            >
              <span class="font-mono text-[12px] tracking-[0.16em] text-cobalt-text">
                {template.number}
              </span>
              <div>
                <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-paper-faint">
                  {template.stage}
                </p>
                <h3 class="studio-display mt-2 text-[clamp(28px,3vw,42px)] leading-tight">
                  {template.title}
                </h3>
                <p class="mt-3 max-w-[760px] text-[15px] leading-[1.7] text-paper-dim">
                  {template.purpose}
                </p>
              </div>
              <a
                href={`/workflow-book/templates/${template.fileName}`}
                download={template.fileName}
                class="studio-button studio-button--secondary sm:col-start-2 lg:col-start-auto"
                data-workflow-book-download={template.slug}
                data-workflow-book-placement="template-list"
              >
                Download text template
              </a>
            </li>
          ))}
        </ol>

        <div class="flex flex-wrap items-center gap-4 border-t border-rule pt-8">
          <a
            href="/workflow-testing-template/"
            class="studio-button studio-button--cobalt"
            data-workflow-template-action="companion-browser-test"
          >
            Use the ten-example testing worksheet
          </a>
          <p class="max-w-xl text-sm leading-[1.7] text-paper-faint">
            The browser worksheet saves only on your device, exports a spreadsheet file, and prints to PDF. Use made-up or specifically approved information only.
          </p>
        </div>
      </section>

      <section
        class="grid gap-8 border-y border-rule py-12 lg:grid-cols-12 lg:py-16"
        aria-labelledby="versioning-title"
      >
        <div class="lg:col-span-4">
          <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
            Book and companion
          </p>
          <h2
            id="versioning-title"
            class="studio-display mt-4 text-[clamp(34px,4vw,52px)] leading-[1]"
          >
            Why keep the book and <strong>templates separate?</strong>
          </h2>
        </div>
        <div class="grid gap-px bg-rule/70 sm:grid-cols-2 lg:col-span-8">
          <div class="bg-ink p-6">
            <h3 class="text-lg font-semibold">The book explains the decisions</h3>
            <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">
              The book explains sources, approval rights, repeated-task plans, clear results, testing, evidence, failure handling, and team use. These ideas should remain useful as tools change.
            </p>
          </div>
          <div class="bg-ink p-6">
            <h3 class="text-lg font-semibold">The templates can keep improving</h3>
            <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">
              The editable files can receive corrections, new versions, and practical notes without requiring a new edition of the book.
            </p>
          </div>
        </div>
      </section>

      <section class="py-14 lg:py-20" aria-labelledby="faq-title">
        <header class="border-b border-rule pb-8">
          <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
            Before you download
          </p>
          <h2
            id="faq-title"
            class="studio-display mt-4 text-[clamp(42px,6vw,76px)] leading-[0.94]"
          >
            Straight <strong>answers.</strong>
          </h2>
        </header>
        <div class="divide-y divide-rule">
          {faqs.map((faq) => (
            <details class="group py-7">
              <summary class="cursor-pointer list-none pr-8 text-lg font-semibold marker:hidden">
                {faq.question}
              </summary>
              <p class="mt-4 max-w-[860px] text-[15px] leading-[1.75] text-paper-dim">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>

      <section class="grid items-end gap-10 border-t border-rule pt-16 lg:grid-cols-12 lg:pt-24">
        <div class="lg:col-span-8">
          <h2 class="studio-display text-[clamp(40px,5.5vw,76px)] leading-[0.96]">
            Build one useful process<span class="text-signal">.</span><br />
            <strong>Keep people responsible.</strong>
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
          <a href={`/books/${workflowBook.slug}/`} class="studio-button studio-button--secondary">Read the book</a>
          <a
            href={kindleEdition.ownedSiteAttributionUrl ?? kindleEdition.amazonUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="studio-button studio-button--cobalt"
            data-amazon-book={workflowBook.slug}
            data-amazon-format="kindle"
            data-amazon-placement="workflow-companion-close"
            data-amazon-attribution={kindleEdition.ownedSiteAttributionUrl ? "book-site-organic" : "unattributed"}
          >Buy the Kindle · $9.99</a>
          <a href="/services/training/" class="studio-button studio-button--secondary">See practical AI training</a>
        </div>
      </section>
    </div>
  </article>
</Base>
