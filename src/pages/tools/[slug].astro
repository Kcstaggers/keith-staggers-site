---
import MinimalStudio from "../../layouts/MinimalStudio.astro";
import { clientTools, type ClientToolConfig } from "../../data/clientTools";

export function getStaticPaths() {
  return clientTools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

interface Props {
  tool: ClientToolConfig;
}

const { tool } = Astro.props;
const configJson = JSON.stringify(tool).replace(/</g, "\\u003c");
---

<MinimalStudio
  title={tool.title}
  description={tool.description}
  noindex={tool.noindex}
  ogImage={tool.ogImage}
  ogImageAlt={tool.ogImageAlt}
>
  <section
    class="client-tool"
    data-client-tool
    data-tool-slug={tool.slug}
    style={`--tool-bg:${tool.colors.background};--tool-text:${tool.colors.text};--tool-muted:${tool.colors.muted};--tool-rule:${tool.colors.rule};--tool-accent:${tool.colors.accent};--tool-action:${tool.colors.action}`}
  >
    <header class="tool-head">
      <a href={`/tools/${tool.slug}/`}>{tool.title}</a>
      <a href={tool.studioHref}>{tool.studioLabel}</a>
    </header>

    <noscript>
      <section class="tool-noscript">
        <h2>This finder needs JavaScript.</h2>
        <p>Your answers stay in the browser, so the scored experience runs locally on your device.</p>
        <a href="/workflow-readiness/">Use the workflow readiness check</a>
      </section>
      <style>.tool-experience { display: none; }</style>
    </noscript>

    <div class="tool-experience">
      <section class="tool-intro" data-tool-intro aria-labelledby="tool-intro-title">
        <p class="tool-intro-eyebrow">{tool.intro.eyebrow}</p>
        <h1 id="tool-intro-title">{tool.intro.title}</h1>
        <p class="tool-intro-summary">{tool.intro.summary}</p>
        <div class="tool-intro-actions">
          <button type="button" data-tool-start>
            Start the finder
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
          <p>{tool.intro.duration}</p>
        </div>
        <p class="tool-intro-privacy">
          Your answers stay on this device. We measure starts, completions, and the final result category only.
        </p>
      </section>

      <form class="tool-question-state" data-tool-form hidden>
        <div class="tool-progress-wrap">
          <p data-tool-progress-label>Question 1 of {tool.questions.length}</p>
          <div class="tool-progress" role="progressbar" aria-valuemin="1" aria-valuemax={tool.questions.length} aria-valuenow="1" data-tool-progress>
            <span data-tool-progress-fill style={`width:${100 / tool.questions.length}%`}></span>
          </div>
        </div>

        <div class="tool-questions">
          {tool.questions.map((question, questionIndex) => (
            <fieldset
              class="tool-question"
              data-tool-question
              data-question-index={questionIndex}
              hidden={questionIndex !== 0}
            >
              <legend tabindex="-1">{question.title}</legend>
              <p>{question.help}</p>
              <div class="tool-options">
                {question.options.map((option) => (
                  <label>
                    <input type="radio" name={question.id} value={option.value} />
                    <span class="tool-radio" aria-hidden="true"></span>
                    <span>{option.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </div>

        <div class="tool-question-actions">
          <button class="tool-back" type="button" data-tool-back disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H6M11 6l-6 6 6 6" /></svg>
            Back
          </button>
          <p>
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="1" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
            Answers stay here. Only the result category is measured.
          </p>
          <button class="tool-continue" type="button" data-tool-continue disabled>
            <span data-tool-continue-label>Continue</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>
      </form>

      <section class="tool-result" data-tool-result hidden tabindex="-1" aria-labelledby="tool-result-title">
        <header class="tool-print-head">
          <strong>{tool.title}</strong>
          <span>{tool.studioLabel}</span>
          <span data-tool-print-date></span>
          <span data-tool-print-url></span>
        </header>
        <p class="tool-result-label" data-result-label>Your best first build</p>
        <h2 id="tool-result-title" data-result-title></h2>
        <p class="tool-result-summary" data-result-summary></p>

        <div class="tool-build-first">
          <p>Build this first</p>
          <div class="tool-flow" aria-label="Recommended workflow">
            <strong data-flow-one></strong>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            <strong data-flow-two></strong>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            <strong data-flow-three></strong>
          </div>
        </div>

        <div class="tool-plan">
          <p>Your three-step start</p>
          <ol data-result-steps></ol>
        </div>

        <p class="tool-caution" data-result-caution></p>

        <div class="tool-result-actions">
          <a class="tool-result-cta" data-result-cta href="/project-fit/">
            <span data-result-cta-label>Tell Keith about this task</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </a>
          <button class="tool-print" type="button" data-tool-print>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V4h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v6H7z" /></svg>
            Save or print my plan
          </button>
          <button class="tool-reset" type="button" data-tool-reset>
            Check another workflow
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </div>

        <p class="tool-result-privacy">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="1" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
          Your answers were not stored. We measured the result category only.
        </p>
      </section>
    </div>

    <script is:inline id="client-tool-config" type="application/json" set:html={configJson}></script>
  </section>
</MinimalStudio>

<script>
  import { track } from "@vercel/analytics";
  import { scoreClientTool, type ClientToolConfig } from "../../data/clientTools";

  const intro = document.querySelector<HTMLElement>("[data-tool-intro]");
  const start = document.querySelector<HTMLButtonElement>("[data-tool-start]");
  const form = document.querySelector<HTMLFormElement>("[data-tool-form]");
  const result = document.querySelector<HTMLElement>("[data-tool-result]");
  const configElement = document.querySelector<HTMLScriptElement>("#client-tool-config");
  const config = configElement
    ? (JSON.parse(configElement.textContent || "{}") as ClientToolConfig)
    : null;
  const questions = Array.from(document.querySelectorAll<HTMLFieldSetElement>("[data-tool-question]"));
  const progressLabel = document.querySelector<HTMLElement>("[data-tool-progress-label]");
  const progress = document.querySelector<HTMLElement>("[data-tool-progress]");
  const progressFill = document.querySelector<HTMLElement>("[data-tool-progress-fill]");
  const back = document.querySelector<HTMLButtonElement>("[data-tool-back]");
  const next = document.querySelector<HTMLButtonElement>("[data-tool-continue]");
  const nextLabel = document.querySelector<HTMLElement>("[data-tool-continue-label]");
  const reset = document.querySelector<HTMLButtonElement>("[data-tool-reset]");
  const print = document.querySelector<HTMLButtonElement>("[data-tool-print]");
  const resultCta = document.querySelector<HTMLAnchorElement>("[data-result-cta]");
  const printDate = document.querySelector<HTMLElement>("[data-tool-print-date]");
  const printUrl = document.querySelector<HTMLElement>("[data-tool-print-url]");
  let currentQuestion = 0;
  let started = false;

  const selectedValue = (index: number) =>
    questions[index]?.querySelector<HTMLInputElement>('input[type="radio"]:checked')?.value;

  const updateQuestion = (focus = true) => {
    if (!config || !questions.length) return;
    questions.forEach((question, index) => { question.hidden = index !== currentQuestion; });
    const number = currentQuestion + 1;
    const percent = (number / questions.length) * 100;
    if (progressLabel) progressLabel.textContent = `Question ${number} of ${questions.length}`;
    if (progress) progress.setAttribute("aria-valuenow", String(number));
    if (progressFill) progressFill.style.width = `${percent}%`;
    if (back) back.disabled = currentQuestion === 0;
    if (next) next.disabled = !selectedValue(currentQuestion);
    if (nextLabel) nextLabel.textContent = currentQuestion === questions.length - 1 ? "See my result" : "Continue";
    if (focus) questions[currentQuestion]?.querySelector<HTMLElement>("legend")?.focus();
  };

  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const showResult = () => {
    if (!config || !form || !result) return;
    const submitted = new FormData(form);
    const answers = Object.fromEntries(
      config.questions.map((question) => [question.id, String(submitted.get(question.id) ?? "")]),
    );
    const scored = scoreClientTool(config, answers);
    const outcome = scored.gated
      ? config.gatedOutcome
      : config.outcomes[scored.outcomeKey];
    const outcomeKey = scored.outcomeKey;

    setText("[data-result-label]", outcome.label);
    setText("[data-result-title]", outcome.title);
    setText("[data-result-summary]", outcome.summary);
    setText("[data-flow-one]", outcome.flow[0]);
    setText("[data-flow-two]", outcome.flow[1]);
    setText("[data-flow-three]", outcome.flow[2]);
    setText("[data-result-caution]", outcome.caution);
    setText("[data-result-cta-label]", outcome.ctaLabel);
    if (resultCta) {
      resultCta.href = outcome.ctaHref;
      resultCta.dataset.outcome = outcomeKey;
    }

    const stepList = document.querySelector<HTMLOListElement>("[data-result-steps]");
    if (stepList) {
      stepList.replaceChildren(...outcome.steps.map((step) => {
        const item = document.createElement("li");
        item.textContent = step;
        return item;
      }));
    }

    form.hidden = true;
    result.hidden = false;
    result.dataset.outcome = outcomeKey;
    if (printDate) {
      printDate.textContent = `Saved ${new Intl.DateTimeFormat("en-US", { dateStyle: "long" }).format(new Date())}`;
    }
    if (printUrl) printUrl.textContent = window.location.href;
    result.focus();
    track("Client Tool Completed", { tool: config.slug, outcome: outcomeKey });
  };

  start?.addEventListener("click", () => {
    if (intro) intro.hidden = true;
    if (form) form.hidden = false;
    updateQuestion();
  });

  form?.addEventListener("change", () => {
    if (!started && config) {
      started = true;
      track("Client Tool Started", { tool: config.slug });
    }
    if (next) next.disabled = !selectedValue(currentQuestion);
  });

  next?.addEventListener("click", () => {
    if (!selectedValue(currentQuestion)) return;
    if (currentQuestion === questions.length - 1) {
      showResult();
      return;
    }
    currentQuestion += 1;
    updateQuestion();
  });

  back?.addEventListener("click", () => {
    if (currentQuestion === 0) return;
    currentQuestion -= 1;
    updateQuestion();
  });

  reset?.addEventListener("click", () => {
    form?.reset();
    if (result) result.hidden = true;
    if (form) form.hidden = false;
    currentQuestion = 0;
    started = false;
    updateQuestion();
  });

  print?.addEventListener("click", () => window.print());

  resultCta?.addEventListener("click", () => {
    if (!config) return;
    track("Client Tool CTA", {
      tool: config.slug,
      outcome: resultCta.dataset.outcome || "unknown",
    });
  });

  updateQuestion(false);
</script>

<style>
  .client-tool {
    min-height: 100dvh;
    padding: 0 1.25rem 2rem;
    background: var(--tool-bg);
    color: var(--tool-text);
  }

  .tool-head {
    width: min(100%, 1420px);
    min-height: 5rem;
    margin-inline: auto;
    border-bottom: 1px solid var(--tool-rule);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .tool-head a {
    color: var(--tool-text);
    text-decoration: none;
  }

  .tool-head a:first-child {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 620;
  }

  .tool-head a:last-child { color: #e2e4ea; font-size: 0.9rem; }
  .tool-head a:hover,
  .tool-head a:focus-visible { color: #7891ff; }

  .tool-experience,
  .tool-noscript {
    width: min(100%, 1220px);
    margin-inline: auto;
  }

  .tool-intro {
    max-width: 1100px;
    padding: clamp(4.5rem, 9vw, 8.5rem) 0 4rem;
  }

  .tool-intro[hidden],
  .tool-question-state[hidden] { display: none; }

  .tool-intro-eyebrow {
    margin: 0 0 1rem;
    color: #5f80ff;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tool-intro h1 {
    max-width: 1040px;
    margin: 0;
    color: var(--tool-text);
    font-family: var(--font-serif);
    font-size: clamp(4.2rem, 8vw, 7.8rem);
    font-weight: 570;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .tool-intro-summary {
    max-width: 820px;
    margin: 1.7rem 0 0;
    color: #d4d7df;
    font-size: clamp(1.08rem, 1.8vw, 1.35rem);
    line-height: 1.55;
  }

  .tool-intro-actions {
    margin-top: 2.2rem;
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .tool-intro-actions button {
    min-width: 230px;
    min-height: 4.2rem;
    border: 1px solid var(--tool-action);
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 1.4rem;
    background: var(--tool-action);
    color: #050608;
    font: 700 0.95rem/1 var(--font-sans);
    cursor: pointer;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .tool-intro-actions button:hover,
  .tool-intro-actions button:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 18px 50px rgb(255 96 77 / 0.22);
  }

  .tool-intro-actions svg {
    width: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-intro-actions p,
  .tool-intro-privacy {
    color: #979ca8;
    font-size: 0.82rem;
  }

  .tool-intro-privacy {
    max-width: 680px;
    margin: 1.3rem 0 0;
    line-height: 1.5;
  }

  .tool-question-state { padding-top: clamp(2.2rem, 5vw, 4.8rem); }

  .tool-progress-wrap p {
    margin: 0 0 0.8rem;
    color: #e1e3e9;
    font-size: 1rem;
  }

  .tool-progress {
    height: 2px;
    overflow: hidden;
    background: var(--tool-rule);
  }

  .tool-progress span {
    display: block;
    height: 100%;
    background: var(--tool-accent);
    transition: width 240ms ease;
  }

  .tool-questions { min-height: 610px; }

  .tool-question {
    min-width: 0;
    margin: 0;
    border: 0;
    padding: clamp(2.5rem, 3.5vw, 3.4rem) 0 0;
  }

  .tool-question[hidden] { display: none; }

  .tool-question legend {
    max-width: 1120px;
    padding: 0;
    color: var(--tool-text);
    font-family: var(--font-serif);
    font-size: clamp(3.1rem, 4.6vw, 4.6rem);
    font-weight: 570;
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .tool-question > p {
    margin: 1.4rem 0 1.9rem;
    color: #d3d6de;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
  }

  .tool-options {
    display: grid;
    gap: 0.75rem;
  }

  .tool-options label {
    min-height: 5.7rem;
    border: 1px solid #454b58;
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    align-items: center;
    gap: 1.3rem;
    padding: 1rem 1.5rem;
    color: #eef0f5;
    cursor: pointer;
    font-size: clamp(1rem, 1.55vw, 1.2rem);
    transition: border-color 170ms ease, background 170ms ease;
  }

  .tool-options label:hover { border-color: #7189ee; }
  .tool-options label:has(input:checked) {
    border-color: var(--tool-accent);
    background: rgb(40 81 255 / 0.055);
  }

  .tool-options input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
  }

  .tool-radio {
    width: 1.45rem;
    height: 1.45rem;
    border: 2px solid #747986;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }

  .tool-radio::after {
    content: "";
    width: 0.68rem;
    height: 0.68rem;
    border-radius: 50%;
    background: transparent;
  }

  .tool-options input:focus-visible + .tool-radio {
    outline: 2px solid var(--tool-action);
    outline-offset: 5px;
  }

  .tool-options input:checked + .tool-radio { border-color: var(--tool-accent); }
  .tool-options input:checked + .tool-radio::after { background: var(--tool-accent); }

  .tool-question-actions {
    border-top: 1px solid var(--tool-rule);
    padding-top: 1.6rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
  }

  .tool-question-actions button,
  .tool-result-actions a,
  .tool-result-actions button {
    min-height: 4rem;
    border: 1px solid var(--tool-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.3rem;
    padding: 0.9rem 1.4rem;
    font: 650 0.93rem/1 var(--font-sans);
    text-decoration: none;
    cursor: pointer;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .tool-question-actions button svg,
  .tool-result-actions svg,
  .tool-result-privacy svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-back {
    width: 175px;
    justify-self: start;
    background: transparent;
    color: var(--tool-text);
  }

  .tool-back:disabled { opacity: 0; pointer-events: none; }

  .tool-question-actions > p {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #979ca8;
    font-size: 0.82rem;
  }

  .tool-question-actions > p svg {
    width: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.45;
  }

  .tool-continue {
    min-width: 230px;
    justify-self: end;
    border-color: var(--tool-accent) !important;
    background: var(--tool-accent);
    color: white;
  }

  .tool-continue:disabled { cursor: not-allowed; opacity: 0.38; }
  .tool-question-actions button:hover:not(:disabled),
  .tool-question-actions button:focus-visible:not(:disabled),
  .tool-result-actions a:hover,
  .tool-result-actions a:focus-visible,
  .tool-result-actions button:hover,
  .tool-result-actions button:focus-visible { transform: translateY(-2px); }

  .tool-result {
    padding: clamp(2.7rem, 5vw, 4.4rem) 0 1rem;
  }

  .tool-result[hidden] { display: none; }
  .tool-print-head { display: none; }

  .tool-result-label,
  .tool-build-first > p,
  .tool-plan > p {
    margin: 0 0 0.8rem;
    color: #4f73ff;
    font-size: 1rem;
    font-weight: 590;
  }

  .tool-result h2 {
    max-width: 1180px;
    margin: 0;
    color: var(--tool-text);
    font-family: var(--font-serif);
    font-size: clamp(3.6rem, 6.7vw, 6.6rem);
    font-weight: 570;
    letter-spacing: -0.05em;
    line-height: 0.92;
  }

  .tool-result-summary {
    max-width: 900px;
    margin: 1.15rem 0 0;
    color: #d4d7df;
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    line-height: 1.55;
  }

  .tool-build-first { margin-top: clamp(2rem, 4vw, 3.2rem); }

  .tool-flow {
    border-bottom: 1px solid var(--tool-rule);
    padding-bottom: 1.5rem;
    display: grid;
    grid-template-columns: auto 2rem auto 2rem auto;
    align-items: center;
    gap: 1rem;
  }

  .tool-flow strong {
    color: #f0f2f7;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 560;
  }

  .tool-flow svg {
    width: 1.6rem;
    fill: none;
    stroke: var(--tool-accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tool-plan { margin-top: 1.7rem; }
  .tool-plan ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: plan;
  }

  .tool-plan li {
    min-height: 3.2rem;
    border-bottom: 1px solid rgb(48 53 66 / 0.55);
    display: grid;
    grid-template-columns: 2.15rem 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem 0;
    color: #e2e4ea;
    line-height: 1.4;
    counter-increment: plan;
  }

  .tool-plan li::before {
    content: counter(plan);
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--tool-accent);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: #f4f6fb;
    font-size: 0.78rem;
  }

  .tool-caution {
    margin: 1.1rem 0 0;
    border-left: 4px solid var(--tool-action);
    padding: 0.7rem 1.15rem;
    color: #e6e8ed;
    line-height: 1.5;
  }

  .tool-result-actions {
    margin-top: 1.35rem;
    border-top: 1px solid var(--tool-rule);
    padding-top: 1.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .tool-result-cta {
    border-color: var(--tool-action) !important;
    background: var(--tool-action);
    color: #050608;
