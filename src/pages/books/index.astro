---
import Base from "../../layouts/Base.astro";
import {
  books,
  liveEditionsFor,
  paperbackEditionFor,
} from "../../data/books";
import { site } from "../../data/site";

const canonicalUrl = `${site.url}/books/`;
const booksJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#page`,
      name: "Books by Keith Staggers",
      description:
        "The public book catalog from Keith Staggers: one practical AI workflow guide and two books about nursing and healthcare leadership.",
      url: canonicalUrl,
      dateModified: "2026-07-31",
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#keith` },
      mainEntity: { "@id": `${canonicalUrl}#books` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#books`,
      name: "Primary books by Keith Staggers",
      numberOfItems: books.length,
      itemListElement: books.map((book, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `${site.url}/books/${book.slug}/`,
        item: { "@id": `${site.url}/books/${book.slug}/#book` },
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Books",
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Base
  title="Books by Keith Staggers"
  description="Explore three books by Keith Staggers about practical AI workflows, surviving med-surg nursing, and leading healthcare teams."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(booksJsonLd)} />
  </Fragment>

  <article class="px-6 pb-20 pt-10 lg:px-12 lg:pb-28 lg:pt-16">
    <div class="mx-auto max-w-[1280px]">
      <nav class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-paper">Home</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <span class="text-cobalt-text" aria-current="page">Books</span>
      </nav>

      <header class="grid gap-10 border-b border-rule pb-16 lg:grid-cols-12 lg:items-end lg:pb-24">
        <div class="lg:col-span-8">
          <h1 class="studio-display text-[clamp(58px,9vw,124px)] leading-[0.86]">
            Books for real work<br />and <strong>real decisions</strong><span class="text-signal">.</span>
          </h1>
        </div>
        <div class="lg:col-span-4">
          <p class="text-[18px] leading-[1.7] text-paper-dim">
            Keith has written three books: a practical guide to controlled AI workflows, an honest account of med-surg nursing, and a guide to healthcare leadership.
          </p>
          <p class="mt-5 font-mono text-[11px] tracking-[0.14em] uppercase text-paper-faint">
            Kindle and paperback · English · Published from 2023 to 2026
          </p>
        </div>
      </header>

      <section class="divide-y divide-rule" aria-label="Books by Keith Staggers">
        {books.map((book, index) => {
          const liveEditions = liveEditionsFor(book);
          const paperbackEdition = paperbackEditionFor(book);
          return (
          <article class="grid gap-10 py-16 lg:grid-cols-12 lg:items-center lg:py-24">
            <a
              href={`/books/${book.slug}/`}
              class="group mx-auto block w-full max-w-[360px] lg:col-span-4 lg:mx-0"
              aria-label={`Read about ${book.title}`}
            >
              <img
                src={`/media/book-${book.slug}.webp`}
                alt={`${book.title}: ${book.subtitle} by Keith Staggers book cover`}
                width={book.coverWidth}
                height={book.coverHeight}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
                decoding="async"
                class="aspect-[2/3] w-full border border-rule bg-ink object-contain shadow-2xl transition duration-300 group-hover:-translate-y-1 group-hover:border-cobalt"
              />
            </a>

            <div class="lg:col-span-7 lg:col-start-6">
              <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
                {book.topic} · {new Date(`${book.datePublished}T12:00:00Z`).getUTCFullYear()}
              </p>
              <h2 class="studio-display mt-5 text-[clamp(38px,5vw,70px)] leading-[0.96]">
                <a href={`/books/${book.slug}/`} class="transition-colors hover:text-cobalt-text">{book.title}</a>
              </h2>
              <p class="mt-4 serif text-[clamp(21px,2vw,28px)] italic text-paper-dim">{book.subtitle}</p>
              <p class="mt-7 max-w-[720px] text-[17px] leading-[1.75] text-paper-dim">{book.blurb}</p>
              <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-3 border-y border-rule py-5 font-mono text-[10px] tracking-[0.12em] uppercase text-paper-faint">
                <div><dt class="sr-only">Formats</dt><dd>{book.editions.map((edition) => edition.format).join(" and ")}</dd></div>
                {paperbackEdition?.pageCount && <div><dt class="sr-only">Print page count</dt><dd>{paperbackEdition.pageCount} print pages</dd></div>}
                {paperbackEdition?.isbn13 && <div><dt class="sr-only">ISBN-13</dt><dd>ISBN {paperbackEdition.isbn13}</dd></div>}
              </dl>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href={`/books/${book.slug}/`} class="studio-button studio-button--cobalt">Read about the book</a>
                {liveEditions.map((edition) => (
                  <a
                    href={edition.amazonUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="studio-button studio-button--secondary"
                    data-amazon-book={book.slug}
                    data-amazon-format={edition.format.toLowerCase()}
                    data-amazon-placement="books-hub"
                  >{edition.format === "Kindle" ? "Buy the Kindle on Amazon" : "See the paperback on Amazon"}{edition.priceUsd ? ` · $${edition.priceUsd}` : ""}</a>
                ))}
              </div>
              {paperbackEdition?.status === "propagating" && <p class="mt-4 font-mono text-[10px] leading-[1.7] tracking-[0.12em] uppercase text-paper-faint">
                Paperback{paperbackEdition.priceUsd ? ` $${paperbackEdition.priceUsd}` : ""} · Published in KDP · U.S. Amazon page still propagating
              </p>}
            </div>
          </article>
          );
        })}
      </section>

      <section class="grid gap-8 border-t border-rule py-16 lg:grid-cols-12 lg:items-end lg:py-24">
        <div class="lg:col-span-8">
          <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">
            Free companion templates
          </p>
          <h2 class="studio-display mt-4 text-[clamp(40px,5.5vw,76px)] leading-[0.96]">
            Ten practical templates<br />you can <strong>use now</strong><span class="text-signal">.</span>
          </h2>
        </div>
        <div class="lg:col-span-4">
          <p class="text-[16px] leading-[1.75] text-paper-dim">
            Download ten free text templates from the companion to Build the Workflow. Keep the Judgment. Use them to organize AI work, record approvals, test a process, and prepare for failures.
          </p>
          <a href="/workflow-book/" class="studio-button studio-button--cobalt mt-7">
            Get the ten free templates
          </a>
          <a href="/books/build-the-workflow-keep-the-judgment/" class="studio-button studio-button--secondary mt-3">
            See the book
          </a>
        </div>
      </section>

      <section class="grid gap-8 border-t border-rule pt-16 lg:grid-cols-12 lg:items-end lg:pt-24">
        <div class="lg:col-span-8">
          <h2 class="studio-display text-[clamp(40px,5.5vw,76px)] leading-[0.96]">
            Books are one part of Keith's <strong>broader work</strong><span class="text-signal">.</span>
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
          <a href="/proof/" class="studio-button studio-button--secondary">See examples of Keith's work</a>
          <a href="/about/" class="studio-button studio-button--secondary">About Keith</a>
        </div>
      </section>
    </div>
  </article>
</Base>
