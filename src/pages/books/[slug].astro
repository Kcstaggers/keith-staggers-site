---
import Base from "../../layouts/Base.astro";
import {
  books,
  liveEditionsFor,
  paperbackEditionFor,
  type Book,
} from "../../data/books";
import { site } from "../../data/site";

export function getStaticPaths() {
  return books.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props as { book: Book };
const canonicalUrl = `${site.url}/books/${book.slug}/`;
const displayDate = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(`${book.datePublished}T12:00:00Z`));
const liveEditions = liveEditionsFor(book);
const primaryLiveEdition = liveEditions[0];
const mobilePurchaseEdition =
  liveEditions.find((edition) => edition.format === "Paperback") ??
  primaryLiveEdition;
const paperbackEdition = paperbackEditionFor(book);
const directAudiobook = book.directAudiobook;
const displayIsbn = paperbackEdition?.isbn13
  ? `${paperbackEdition.isbn13.slice(0, 3)}-${paperbackEdition.isbn13.slice(3)}`
  : undefined;
const workSameAs = [
  book.goodreadsUrl,
  book.openLibraryUrl,
].filter((url): url is string => Boolean(url));
const editionJsonLd = book.editions.map((edition) => {
  const editionId = `${canonicalUrl}#edition-${edition.format.toLowerCase()}`;
  const identifiers = [
    {
      "@type": "PropertyValue",
      propertyID: "ASIN",
      name: `${edition.format} Amazon Standard Identification Number`,
      value: edition.asin,
      ...(edition.amazonUrl ? { url: edition.amazonUrl } : {}),
    },
    ...(edition.isbn13
      ? [
          {
            "@type": "PropertyValue",
            propertyID: "ISBN-13",
            value: edition.isbn13,
          },
        ]
      : []),
  ];

  return {
    "@type": "Book",
    "@id": editionId,
    url: canonicalUrl,
    exampleOfWork: { "@id": `${canonicalUrl}#book` },
    bookEdition: `${edition.format} edition`,
    bookFormat: `https://schema.org/${edition.schemaFormat}`,
    datePublished: book.datePublished,
    inLanguage: book.languageCode,
    creativeWorkStatus: "Published",
    publisher: {
      "@type": "Organization",
      name: book.publisher,
    },
    identifier: identifiers,
    ...(edition.isbn13 ? { isbn: edition.isbn13 } : {}),
    ...(edition.pageCount ? { numberOfPages: edition.pageCount } : {}),
    ...(edition.amazonUrl ? { sameAs: edition.amazonUrl } : {}),
    ...(edition.status === "live" && edition.amazonUrl
      ? {
          offers: {
            "@type": "Offer",
            url: edition.amazonUrl,
            priceCurrency: "USD",
            ...(edition.priceUsd ? { price: edition.priceUsd } : {}),
            availability: "https://schema.org/InStock",
            itemCondition: "https://schema.org/NewCondition",
          },
        }
      : {}),
  };
});
const audiobookJsonLd = directAudiobook
  ? {
      "@type": ["Book", "Audiobook"],
      "@id": `${canonicalUrl}#edition-audiobook`,
      name: `${book.title} audiobook`,
      url: canonicalUrl,
      exampleOfWork: { "@id": `${canonicalUrl}#book` },
      bookEdition: "Audiobook edition",
      bookFormat: `https://schema.org/${directAudiobook.schemaFormat}`,
      datePublished: directAudiobook.datePublished,
      inLanguage: book.languageCode,
      creativeWorkStatus: "Published",
      duration: directAudiobook.durationIso,
      encodingFormat: "audio/mpeg",
      author: { "@id": `${site.url}/#keith` },
      publisher: {
        "@type": "Organization",
        name: book.publisher,
      },
      offers: {
        "@type": "Offer",
        url: directAudiobook.checkoutUrl,
        priceCurrency: "USD",
        price: directAudiobook.priceUsd,
        availability: "https://schema.org/InStock",
        itemCondition: "https://schema.org/NewCondition",
        seller: { "@id": `${site.url}/#keith` },
      },
    }
  : undefined;
const bookJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#page`,
      name: `${book.title}: ${book.subtitle}`,
      description: book.seoDescription,
      url: canonicalUrl,
      datePublished: book.datePublished,
      dateModified: book.dateModified,
      inLanguage: book.languageCode,
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${canonicalUrl}#book` },
      mainEntity: { "@id": `${canonicalUrl}#book` },
      primaryImageOfPage: { "@id": `${canonicalUrl}#cover` },
    },
    {
      "@type": "Book",
      "@id": `${canonicalUrl}#book`,
      name: book.title,
      alternateName: book.subtitle,
      description: book.blurb,
      url: canonicalUrl,
      ...(workSameAs.length ? { sameAs: workSameAs } : {}),
      author: { "@id": `${site.url}/#keith` },
      mainEntityOfPage: { "@id": `${canonicalUrl}#page` },
      image: { "@id": `${canonicalUrl}#cover` },
      datePublished: book.datePublished,
      inLanguage: book.languageCode,
      publisher: {
        "@type": "Organization",
        name: book.publisher,
      },
      workExample: [
        ...editionJsonLd.map((edition) => ({ "@id": edition["@id"] })),
        ...(audiobookJsonLd ? [{ "@id": audiobookJsonLd["@id"] }] : []),
      ],
      keywords: book.themes,
      audience: book.audience.map((audienceType) => ({
        "@type": "Audience",
        audienceType,
      })),
    },
    ...editionJsonLd,
    ...(audiobookJsonLd ? [audiobookJsonLd] : []),
    {
      "@type": "ImageObject",
      "@id": `${canonicalUrl}#cover`,
      url: `${site.url}/media/book-${book.slug}.webp`,
      contentUrl: `${site.url}/media/book-${book.slug}.webp`,
      width: book.coverWidth,
      height: book.coverHeight,
      caption: `${book.title}: ${book.subtitle} by Keith Staggers`,
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Books",
          item: `${site.url}/books/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: book.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Base
  title={book.seoTitle}
  description={book.seoDescription}
  ogType="book"
  ogImage={`/media/book-${book.slug}.webp`}
  ogImageAlt={`${book.title}: ${book.subtitle} by Keith Staggers book cover`}
  ogImageWidth={book.coverWidth}
  ogImageHeight={book.coverHeight}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(bookJsonLd)} />
  </Fragment>

  <article
    class="px-6 pb-36 pt-10 lg:px-12 lg:pb-28 lg:pt-16"
    data-book-landing={book.slug}
  >
    <div class="mx-auto max-w-[1280px]">
      <nav class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-paper">Home</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <a href="/books/" class="transition-colors hover:text-paper">Books</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <span class="text-cobalt-text" aria-current="page">{book.title}</span>
      </nav>

      <header class="grid gap-12 border-b border-rule pb-16 lg:grid-cols-12 lg:items-center lg:gap-16 lg:pb-24">
        <div class="lg:col-span-7">
          <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-cobalt-text">
            {book.topic} · By <a href="/about/" rel="author" class="underline decoration-rule underline-offset-4 transition-colors hover:text-paper">Keith Staggers</a>
          </p>
          <h1 class="studio-display mt-6 text-[clamp(54px,8vw,108px)] leading-[0.87]">{book.title}{!book.title.endsWith(".") && <span class="text-signal">.</span>}</h1>
          <p class="mt-6 max-w-[760px] serif text-[clamp(24px,3vw,38px)] leading-tight italic text-paper-dim">{book.subtitle}</p>
          <p class="mt-8 max-w-[740px] text-[18px] leading-[1.75] text-paper-dim">{book.blurb}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            {directAudiobook && (
              <a
                href={directAudiobook.checkoutUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="studio-button studio-button--primary"
                data-audiobook-purchase={book.slug}
                data-audiobook-format="mp3"
                data-audiobook-placement="book-hero"
                data-audiobook-destination="lemon-squeezy"
              >Buy the audiobook · ${directAudiobook.priceUsd} once</a>
            )}
            {liveEditions.map((edition) => (
              <a
                href={edition.ownedSiteAttributionUrl ?? edition.amazonUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="studio-button studio-button--primary"
                data-amazon-book={book.slug}
                data-amazon-format={edition.format.toLowerCase()}
                data-amazon-placement="book-hero"
                data-amazon-attribution={edition.ownedSiteAttributionUrl ? "book-site-organic" : "unattributed"}
              >{edition.format === "Kindle" ? "Get the Kindle on Amazon" : "Buy the paperback on Amazon"}{edition.priceUsd ? ` · $${edition.priceUsd}` : ""}</a>
            ))}
            {book.companionUrl && <a href={book.companionUrl} class="studio-button studio-button--secondary">Get the free templates</a>}
            <a href="#book-details" class="studio-button studio-button--secondary">Book details</a>
          </div>
          {directAudiobook && <p class="mt-4 max-w-[740px] text-[14px] leading-[1.7] text-paper-dim">
            {directAudiobook.durationLabel} · {directAudiobook.deliveryLabel} · {directAudiobook.availabilityLabel} · {directAudiobook.narrationDisclosure}
          </p>}
          {paperbackEdition?.status === "propagating" && <p class="mt-4 font-mono text-[10px] leading-[1.7] tracking-[0.12em] uppercase text-paper-faint">
            Paperback{paperbackEdition.priceUsd ? ` $${paperbackEdition.priceUsd}` : ""} · Published in KDP · U.S. Amazon page still propagating
          </p>}
        </div>

        <figure class="mx-auto w-full max-w-[420px] lg:col-span-5">
          <img
            src={`/media/book-${book.slug}.webp`}
            alt={`${book.title}: ${book.subtitle} by Keith Staggers book cover`}
            width={book.coverWidth}
            height={book.coverHeight}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="max-h-[680px] w-full border border-rule bg-ink object-contain shadow-2xl"
          />
          <figcaption class="mt-4 font-mono text-[10px] tracking-[0.12em] uppercase text-paper-faint">
            {[...(directAudiobook ? [directAudiobook.format] : []), ...book.editions.map((edition) => edition.format)].join(", ")}{paperbackEdition?.pageCount ? ` · ${paperbackEdition.pageCount} print pages` : ""} · {book.publisher}
          </figcaption>
        </figure>
      </header>

      <div class="grid gap-14 py-16 lg:grid-cols-12 lg:py-24">
        <div class="lg:col-span-7">
          <section aria-labelledby="about-book-title">
            <h2 id="about-book-title" class="studio-display text-[clamp(38px,5vw,66px)] leading-[0.98]">
              About the <strong>book</strong><span class="text-signal">.</span>
            </h2>
            <div class="mt-8 space-y-6 text-[17px] leading-[1.8] text-paper-dim">
              {book.overview.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </section>

          <section class="mt-16 border-t border-rule pt-14" aria-labelledby="themes-title">
            <h2 id="themes-title" class="serif text-[32px] leading-tight">What it addresses</h2>
            <ul class="mt-7 space-y-5">
              {book.themes.map((theme) => (
                <li class="flex gap-4 text-[16px] leading-[1.7] text-paper-dim">
                  <span class="mt-0.5 text-cobalt-text" aria-hidden="true">→</span>
                  <span>{theme}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="mt-16 border-t border-rule pt-14" aria-labelledby="audience-title">
            <h2 id="audience-title" class="serif text-[32px] leading-tight">Who it is for</h2>
            <ul class="mt-7 grid gap-px bg-rule/70 sm:grid-cols-3">
              {book.audience.map((audience, index) => (
                <li class="bg-ink p-6 text-[15px] leading-[1.7] text-paper-dim">
                  <span class="mb-4 block font-mono text-[10px] tracking-[0.16em] text-cobalt-text">{String(index + 1).padStart(2, "0")}</span>
                  {audience}
                </li>
              ))}
            </ul>
          </section>
        </div>

        <aside id="book-details" class="scroll-mt-28 lg:col-span-4 lg:col-start-9" aria-labelledby="book-details-title">
          <div class="border border-rule bg-panel/70 p-7 lg:sticky lg:top-28 lg:p-8">
            <h2 id="book-details-title" class="studio-kicker">Verified edition details</h2>
            <dl class="divide-y divide-rule">
              <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">Published</dt><dd class="text-sm text-paper-dim">{displayDate}</dd></div>
              <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">Publisher</dt><dd class="text-sm text-paper-dim">{book.publisher}</dd></div>
              <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">Formats</dt><dd class="text-sm text-paper-dim">{[...(directAudiobook ? [directAudiobook.format] : []), ...book.editions.map((edition) => edition.format)].join(", ")}</dd></div>
              {paperbackEdition?.pageCount && <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">Print length</dt><dd class="text-sm text-paper-dim">{paperbackEdition.pageCount} pages</dd></div>}
              <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">Language</dt><dd class="text-sm text-paper-dim">{book.language}</dd></div>
              {displayIsbn && <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4"><dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">ISBN-13</dt><dd class="break-all font-mono text-[12px] text-paper-dim">{displayIsbn}</dd></div>}
              {book.editions.map((edition) => (
                <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4">
                  <dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">{edition.format}</dt>
                  <dd class="text-sm leading-[1.6] text-paper-dim">
                    <span class="block font-mono text-[12px]">ASIN {edition.asin}</span>
                    {edition.priceUsd && <span class="block">${edition.priceUsd} USD</span>}
                    {edition.status === "propagating" && <span class="block text-paper-faint">Published in KDP. The U.S. Amazon page is still propagating.</span>}
                  </dd>
                </div>
              ))}
              {directAudiobook && (
                <div class="grid grid-cols-[7.5rem_1fr] gap-4 py-4">
                  <dt class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">Audiobook</dt>
                  <dd class="text-sm leading-[1.6] text-paper-dim">
                    <span class="block">${directAudiobook.priceUsd} USD once</span>
                    <span class="block">{directAudiobook.durationLabel} · {directAudiobook.deliveryLabel}</span>
                    <span class="block">{directAudiobook.availabilityLabel}</span>
                    <span class="block text-paper-faint">{directAudiobook.narrationDisclosure}</span>
                  </dd>
                </div>
              )}
            </dl>
            {(book.goodreadsUrl || book.openLibraryUrl) && <div class="border-t border-rule pt-5">
              <p class="font-mono text-[10px] tracking-[0.13em] uppercase text-paper-faint">Catalog records</p>
              <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-paper-dim">
                {book.goodreadsUrl && <a
                  href={book.goodreadsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-rule underline-offset-4 transition-colors hover:text-paper"
                >Goodreads ↗</a>}
                {book.openLibraryUrl && <a
                  href={book.openLibraryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline decoration-rule underline-offset-4 transition-colors hover:text-paper"
                >Open Library ↗</a>}
              </div>
            </div>}
            <div class="mt-7 grid gap-3">
              {liveEditions.map((edition) => (
                <a
                  href={edition.ownedSiteAttributionUrl ?? edition.amazonUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="studio-button studio-button--cobalt w-full"
                  data-amazon-book={book.slug}
                  data-amazon-format={edition.format.toLowerCase()}
                  data-amazon-placement="book-details"
                  data-amazon-attribution={edition.ownedSiteAttributionUrl ? "book-site-organic" : "unattributed"}
                >Open {edition.format} listing</a>
              ))}
            </div>
          </div>
        </aside>
      </div>

      <section class="grid items-end gap-10 border-t border-rule pt-16 lg:grid-cols-12 lg:pt-24">
        <div class="lg:col-span-8">
          <h2 class="studio-display text-[clamp(40px,5.5vw,76px)] leading-[0.96]">
            Learn more about Keith and his <strong>other work</strong><span class="text-signal">.</span>
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
          <a href="/books/" class="studio-button studio-button--secondary">All books</a>
          <a href="/notes/" class="studio-button studio-button--secondary">Read articles and guides</a>
        </div>
      </section>
    </div>

    {mobilePurchaseEdition && (
      <aside
        class="fixed inset-x-0 bottom-0 z-50 border-t border-rule bg-ink/95 px-4 py-3 backdrop-blur lg:hidden"
        aria-label={`Buy ${book.title}`}
      >
        <div class="mx-auto flex max-w-[720px] items-center gap-3">
          <p class="min-w-0 flex-1 truncate text-[13px] font-semibold text-paper">
            {book.title}
          </p>
          <a
            href={mobilePurchaseEdition.ownedSiteAttributionUrl ?? mobilePurchaseEdition.amazonUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="studio-button studio-button--cobalt shrink-0"
            data-amazon-book={book.slug}
            data-amazon-format={mobilePurchaseEdition.format.toLowerCase()}
            data-amazon-placement="book-mobile-sticky"
            data-amazon-attribution={mobilePurchaseEdition.ownedSiteAttributionUrl ? "book-site-organic" : "unattributed"}
          >{mobilePurchaseEdition.format === "Kindle" ? "Get Kindle" : "Buy paperback"}{mobilePurchaseEdition.priceUsd ? ` · $${mobilePurchaseEdition.priceUsd}` : ""}</a>
        </div>
      </aside>
    )}
  </article>
</Base>
