---
import Base from "../layouts/Base.astro";
import StudioTestimonial from "../components/StudioTestimonial.astro";
import { books } from "../data/books";
import { site } from "../data/site";

const buildRecord = [
  { value: "21 years", label: "Baltimore detective · 1992 to 2013" },
  { value: "2014 to now", label: "Nurse and nurse leader" },
  { value: "2022 to now", label: "Founder and AI consultant" },
  { value: "50+", label: "Albums released" },
  { value: "800+", label: "Songs released" },
  { value: "1,000+", label: "AI images and films created" },
];
const canonicalUrl = `${site.url}/proof/`;
const proofItems = [
  {
    "@type": "CreativeWork",
    "@id": `${canonicalUrl}#ai-canvas`,
    name: "AI Canvas independent test project",
    description:
      "An independent AI test project that could estimate a cost but was prevented from spending money or using paid services.",
    creator: { "@id": `${site.url}/#keith` },
  },
  {
    "@type": "CreativeWork",
    "@id": `${canonicalUrl}#gearstat`,
    name: "GearSTAT sample equipment-finding app",
    description:
      "An independent sample app for nurses, built and tested with made-up data. It has not been used in a hospital.",
    creator: { "@id": `${site.url}/#keith` },
  },
  ...books.map((book) => ({
    "@id": `${site.url}/books/${book.slug}/#book`,
  })),
];
const proofJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#page`,
      name: "Examples of Keith Staggers' AI Builds, Books and Client Work",
      description:
        "Plain-English examples of Keith Staggers' independent AI projects, client work, healthcare books, and finished creative work.",
      url: canonicalUrl,
      dateModified: "2026-07-31",
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
      about: { "@id": `${site.url}/#keith` },
      mainEntity: { "@id": `${canonicalUrl}#work` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#work`,
      numberOfItems: proofItems.length,
      itemListElement: proofItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item,
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Proof",
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Base
  title="AI Projects, Client Work and Books"
  description="See plain-English examples of Keith Staggers' independent AI projects, client work, healthcare books, and finished creative work."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(proofJsonLd)} />
  </Fragment>

  <article class="proof-page">
    <nav class="studio-shell pt-8 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-paper transition-colors">Home</a>
      <span class="text-rule mx-2" aria-hidden="true">/</span>
      <span class="text-cobalt-text" aria-current="page">Proof</span>
    </nav>

    <header class="studio-shell proof-hero">
      <div>
        <h1 class="studio-display">Examples of what Keith has <strong>built</strong><span class="text-signal">.</span></h1>
      </div>
      <p>
        These are real examples of independent AI projects, client work, books, and finished creative projects. Each example says plainly what it proves and what it does not.
      </p>
    </header>

    <section class="proof-canvas" aria-labelledby="proof-canvas-title">
      <div class="studio-shell proof-canvas-grid">
        <div class="proof-video-wrap">
          <div class="proof-reel-poster">
            <span class="proof-reel-label">AI Canvas · independent test project</span>
            <span class="proof-reel-result"><b>4¢</b><i>→</i><b>$0</b></span>
            <span class="proof-reel-caption">One full practice run · spending disabled</span>
          </div>
        </div>
        <div class="proof-canvas-copy">
          <p class="studio-kicker">AI Canvas · independent test project</p>
          <h2 id="proof-canvas-title" class="studio-display">A test system that could estimate a cost but could not <strong>spend money</strong><span class="text-signal">.</span></h2>
          <p>Keith built and tested a controlled AI production process. It could show an estimated price, but paid services, billing, and public use were turned off.</p>
          <ul>
            <li><b>2,016</b><span>automated checks passed</span></li>
            <li><b>1 run</b><span>full practice run completed</span></li>
            <li><b>$0.04</b><span>estimated cost shown</span></li>
            <li><b>$0</b><span>actually reserved or spent</span></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="studio-shell proof-gearstat" aria-labelledby="proof-gearstat-title">
      <header>
        <p class="studio-kicker">GearSTAT · independent sample app</p>
        <h2 id="proof-gearstat-title" class="studio-display">A sample equipment finder<br />built for <strong>nurses</strong><span class="text-signal">.</span></h2>
      </header>
      <div class="proof-case-grid">
        <article>
          <span>01</span>
          <h3>The problem</h3>
          <p>Nurses can lose time trying to find shared equipment. GearSTAT explored a simpler way to search and record whether an item was found.</p>
        </article>
        <article>
          <span>02</span>
          <h3>What Keith built</h3>
          <p>A nurse-facing sample app using made-up information, with a search path and a way to record the result.</p>
        </article>
        <article>
          <span>03</span>
          <h3>What passed</h3>
          <p>The recorded test point passed 206 of 206 checks and generated all 23 planned pages.</p>
        </article>
        <article>
          <span>04</span>
          <h3>What it is not</h3>
          <p>It used no patient information, did not show staff locations, and was not connected to a hospital. It is a portfolio example, not a hospital deployment or client result.</p>
        </article>
      </div>
    </section>

    <StudioTestimonial />

    <section class="proof-books" aria-labelledby="proof-books-title">
      <div class="studio-shell">
        <header class="proof-books-head">
          <h2 id="proof-books-title" class="studio-display">Books about nursing<br />and <strong>leadership</strong><span class="text-signal">.</span></h2>
          <p>Two books written from Keith's experience in nursing and nurse leadership. <a href="/books/" class="text-cobalt-text underline decoration-rule underline-offset-4 hover:text-paper">See each book and where to buy it.</a></p>
        </header>
        <div class="proof-book-list">
          {books.map((book) => (
            <a href={`/books/${book.slug}/`} class="proof-book">
              <img src={`/media/book-${book.slug}.webp`} alt={`${book.title} book cover`} width="600" height="900" loading="lazy" decoding="async" />
              <span><b>{book.title}</b><small>{book.subtitle}</small></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="studio-shell proof-record" aria-labelledby="proof-record-title">
      <header>
        <h2 id="proof-record-title" class="studio-display">Experience behind the <strong>work</strong><span class="text-signal">.</span></h2>
        <p>Keith's three careers share a practical standard: observe carefully, make the useful thing, check it, and finish it.</p>
      </header>
      <dl>
        {buildRecord.map((item) => (
          <div>
            <dt>{item.value}</dt>
            <dd>{item.label}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="proof-boundary">
      <div class="studio-shell proof-boundary-grid">
        <div>
          <p class="studio-kicker">What is excluded</p>
          <h2 class="studio-display">Only independent work is shown<span class="text-signal">.</span></h2>
        </div>
        <p>Employer projects, employer data, patient information, and internal healthcare workflows are excluded from this portfolio.</p>
      </div>
    </section>

    <section class="studio-shell proof-close">
      <div>
        <h2 class="studio-display">What do you want to make easier<span class="text-signal">?</span></h2>
        <p>Tell Keith about the task, project, training need, or event. He will recommend the simplest useful next step.</p>
      </div>
      <div>
        <a href="/project-fit/" class="studio-button studio-button--primary">Tell Keith about your task</a>
        <a href="/services/" class="studio-button studio-button--secondary">See how Keith can help</a>
      </div>
    </section>
  </article>

</Base>
