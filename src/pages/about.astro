---
import Base from "../layouts/Base.astro";
import OrbitalPortrait from "../components/OrbitalPortrait.astro";
import { site } from "../data/site";

const canonicalUrl = `${site.url}/about/`;
const aboutJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${canonicalUrl}#page`,
      name: "About Keith Staggers",
      description:
        "Keith Staggers teaches leaders and small teams how to use AI at work, helps people solve one real problem, and builds practical tools for repetitive tasks.",
      url: canonicalUrl,
      dateModified: "2026-07-31",
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
      mainEntity: { "@id": `${site.url}/#keith` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "About",
          item: canonicalUrl,
        },
      ],
    },
  ],
};

const careers = [
  {
    dates: "1992 to 2013",
    title: "Baltimore detective",
    copy: "Twenty-one years separating evidence from noise, asking better questions, and writing clearly enough for someone else to act.",
  },
  {
    dates: "2014 to now",
    title: "Nurse and nurse leader",
    copy: "A second career built around staying useful when the room is tense, explaining difficult things clearly, and keeping accountability inside the decision.",
  },
  {
    dates: "2022 to now",
    title: "AI trainer and builder",
    copy: "Hands-on training, one-to-one help, speaking, and done-for-you AI solutions built around real tasks rather than product demonstrations.",
  },
];

const operatingCode = [
  {
    title: "Choose one real task.",
    copy: "Start with what wastes time, who is responsible, and what a good result looks like before choosing a tool.",
  },
  {
    title: "Set clear limits.",
    copy: "Decide what AI may help with, what information it may use, and what a person must decide.",
  },
  {
    title: "Have a person check the result.",
    copy: "Verify the facts, context, tone, and final decision before the result is used or sent.",
  },
  {
    title: "Teach the next person.",
    copy: "Save clear instructions, required checks, and a backup plan so the team can use it without Keith.",
  },
];
---

<Base
  title="About Keith Staggers · AI Trainer and Builder"
  description="Keith Staggers teaches leaders and small teams how to use AI at work, helps people solve one real problem, and builds practical tools for repetitive tasks."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutJsonLd)} />
  </Fragment>

  <article class="px-6 pb-20 pt-10 lg:px-12 lg:pb-28 lg:pt-16">
    <div class="mx-auto max-w-[1280px]">
      <nav class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-paper">Home</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <span class="text-cobalt-text" aria-current="page">About</span>
      </nav>

      <header class="grid items-center gap-12 border-b border-rule pb-16 lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.6fr)] lg:gap-20 lg:pb-24">
        <div>
          <p class="studio-kicker">About Keith Staggers</p>
          <h1 class="studio-display mt-6 text-[clamp(50px,8vw,112px)] leading-[0.92] tracking-[-0.055em]">
            AI trainer.<br />Hands-on <strong>builder</strong><span class="text-signal">.</span>
          </h1>
          <p class="mt-8 max-w-[760px] text-[clamp(18px,2vw,24px)] leading-[1.6] text-paper-dim">
            I teach leaders and small teams how to use AI at work, help people solve one real problem, and build practical tools for repetitive tasks. I am also a working nurse leader, speaker, author, and retired Baltimore detective.
          </p>
          <p class="mt-7 font-mono text-[11px] tracking-[0.16em] uppercase text-paper-faint">
            {site.city} · Available worldwide
          </p>
        </div>
        <div class="mx-auto w-full max-w-[430px]">
          <OrbitalPortrait eager />
        </div>
      </header>

      <section class="grid gap-10 border-b border-rule py-16 lg:grid-cols-12 lg:py-24" aria-labelledby="career-title">
        <div class="lg:col-span-4">
          <p class="studio-kicker">Three careers</p>
          <h2 id="career-title" class="studio-display mt-5 text-[clamp(34px,4vw,58px)] leading-[1]">
            Each career shaped<br /><strong>how Keith works.</strong>
          </h2>
        </div>
        <div class="grid gap-px bg-rule/70 md:grid-cols-3 lg:col-span-8">
          {careers.map((career, index) => (
            <article class="bg-ink p-7">
              <p class="font-mono text-[10px] tracking-[0.16em] uppercase text-cobalt-text">
                {String(index + 1).padStart(2, "0")} · {career.dates}
              </p>
              <h3 class="mt-5 serif text-[25px] leading-tight">{career.title}</h3>
              <p class="mt-4 text-[15px] leading-[1.75] text-paper-dim">{career.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="grid gap-12 border-b border-rule py-16 lg:grid-cols-12 lg:py-24" aria-labelledby="builder-title">
        <div class="lg:col-span-7">
          <p class="studio-kicker">Keith does the work he teaches</p>
          <h2 id="builder-title" class="studio-display mt-5 text-[clamp(38px,5vw,70px)] leading-[0.98]">
            Practical lessons from <strong>building and finishing</strong><span class="text-signal">.</span>
          </h2>
          <div class="mt-8 max-w-[760px] space-y-5 text-[17px] leading-[1.75] text-paper-dim">
            <p>I use AI in real production. My public work includes more than 50 albums, more than 800 songs, three published books, more than 1,000 AI-created images and films, client creative work, and independent software projects.</p>
            <p>Finishing that work taught me where AI genuinely helps, where it creates more confusion, and why a person must still check the result and make the important decisions.</p>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/proof/" class="studio-button studio-button--secondary">See examples of Keith's work</a>
            <a href="/books/" class="studio-button studio-button--secondary">Read the books</a>
          </div>
        </div>
        <dl class="grid grid-cols-2 gap-px bg-rule/70 lg:col-span-5">
          <div class="bg-ink p-6"><dt class="studio-display text-[42px]">50+</dt><dd class="mt-2 text-sm text-paper-dim">albums released</dd></div>
          <div class="bg-ink p-6"><dt class="studio-display text-[42px]">800+</dt><dd class="mt-2 text-sm text-paper-dim">songs released</dd></div>
          <div class="bg-ink p-6"><dt class="studio-display text-[42px]">3</dt><dd class="mt-2 text-sm text-paper-dim">published books</dd></div>
          <div class="bg-ink p-6"><dt class="studio-display text-[42px]">1,000+</dt><dd class="mt-2 text-sm text-paper-dim">AI images and films</dd></div>
        </dl>
      </section>

      <section class="border-b border-rule py-16 lg:py-24" aria-labelledby="code-title">
        <div class="grid gap-10 lg:grid-cols-12">
          <header class="lg:col-span-4">
            <p class="studio-kicker">How Keith works</p>
            <h2 id="code-title" class="studio-display mt-5 text-[clamp(36px,4vw,60px)] leading-[1]">
              Four simple<br /><strong>steps.</strong>
            </h2>
            <p class="mt-6 max-w-sm text-paper-dim">The tools will change. This practical approach stays useful.</p>
          </header>
          <ol class="grid gap-px bg-rule/70 md:grid-cols-2 lg:col-span-8">
            {operatingCode.map((item, index) => (
              <li class="bg-ink p-7">
                <span class="font-mono text-[10px] tracking-[0.16em] text-cobalt-text">{String(index + 1).padStart(2, "0")}</span>
                <h3 class="mt-4 serif text-[24px]">{item.title}</h3>
                <p class="mt-3 text-[15px] leading-[1.7] text-paper-dim">{item.copy}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="grid gap-10 border-b border-rule py-16 lg:grid-cols-12 lg:py-24" aria-labelledby="shared-title">
        <div class="lg:col-span-5">
          <h2 id="shared-title" class="studio-display text-[clamp(36px,4.5vw,64px)] leading-[0.98]">
            What Keith can <strong>help with today</strong><span class="text-signal">.</span>
          </h2>
        </div>
        <div class="space-y-6 text-[18px] leading-[1.75] text-paper-dim lg:col-span-7">
          <p>Detective work taught me to observe before acting. Nursing taught me that important decisions have consequences. Production taught me that an idea has little value until it is finished and released.</p>
          <p>Today I build AI-assisted solutions for repetitive tasks, help people one-to-one, train teams, speak about AI and reinvention, and take on selected creative production work. The Finish Loop is a $49 do-it-yourself toolkit for creators who need help finishing and releasing a project.</p>
          <div class="flex flex-wrap gap-3 pt-2">
            <a href="/services/" class="studio-button studio-button--secondary">See how Keith can help</a>
            <a href="/finish-loop/" class="studio-button studio-button--secondary">See the project-finishing toolkit</a>
            <a href="/notes/" class="studio-button studio-button--secondary">Read articles and guides</a>
          </div>
        </div>
      </section>

      <section class="grid gap-8 border-b border-rule py-12 lg:grid-cols-12" aria-labelledby="boundary-title">
        <div class="lg:col-span-4">
          <p class="studio-kicker">What is excluded</p>
          <h2 id="boundary-title" class="mt-4 serif text-[30px]">Only independent work is shown.</h2>
        </div>
        <p class="max-w-[720px] text-[16px] leading-[1.75] text-paper-dim lg:col-span-8">
          Everything shown here is independent work. Employer projects, employer data, patient information, and internal healthcare workflows are excluded.
        </p>
      </section>

      <section class="grid items-end gap-10 pt-16 lg:grid-cols-12 lg:pt-24">
        <div class="lg:col-span-8">
          <p class="studio-kicker">Work with me</p>
          <h2 class="studio-display mt-5 text-[clamp(40px,5.5vw,76px)] leading-[0.96]">
            What task or project do you want to make <strong>easier</strong><span class="text-signal">?</span>
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-4 lg:justify-end">
          <a href="/project-fit/" class="studio-button studio-button--primary">Tell Keith about your task</a>
          <a href="/proof/" class="studio-button studio-button--secondary">See examples</a>
        </div>
      </section>
    </div>
  </article>
</Base>
