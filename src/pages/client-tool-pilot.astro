---
import MinimalStudio from "../layouts/MinimalStudio.astro";
import {
  clientToolPilotFormConfigured,
  clientToolPilotFormEndpoint,
} from "../data/clientToolPilot";
---

<MinimalStudio
  title="Three Complimentary Interactive Website Tool Builds"
  description="Keith builds a branded two-minute website tool that answers a common client question and guides each visitor to the right next step."
>
  <div class="pilot-page">
    <header class="pilot-nav" aria-label="Pilot navigation">
      <a class="pilot-brand" href="/">Keith Staggers</a>
      <nav aria-label="Studio links">
        <a href="/">Studio</a>
        <a href="/#work">Work</a>
        <a href="/#notes">Notes</a>
      </nav>
    </header>

    <section class="pilot-hero" aria-labelledby="pilot-title">
      <div class="pilot-copy">
        <div class="pilot-copy-inner">
          <p class="pilot-eyebrow">Three complimentary founding builds for consultants, coaches, educators, and service businesses</p>
          <h1 id="pilot-title">Turn the question potential clients keep asking into an interactive website guide.</h1>
          <p>If people keep asking “Which service is right for me?”, send me your website, that question, and the page you want the right visitor to reach. I build the questions, personalized recommendation, next-step links, share image, and launch copy.</p>
          <div class="pilot-actions">
            <a class="pilot-primary" href="/tools/first-ai-workflow/">
              Try a finished tool
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            </a>
            <a class="pilot-secondary" href="#pilot-form">
              {clientToolPilotFormConfigured ? "Apply with the short brief" : "Review the short application"}
            </a>
          </div>
        </div>

        <ul class="pilot-proof" aria-label="Pilot boundaries">
          <li>Built for you at no charge during the three-build pilot</li>
          <li>A private review link before anything goes public</li>
          <li>One correction round and a launch-ready handoff</li>
        </ul>
      </div>

      <div class="pilot-form-wrap" id="pilot-form">
        <form
          class="pilot-form"
          data-client-tool-pilot-form
          data-form-configured={String(clientToolPilotFormConfigured)}
          action={clientToolPilotFormEndpoint || undefined}
          method="post"
          accept-charset="UTF-8"
        >
          <input type="hidden" name="subject" value="[KS Client Tool Pilot] {{ email }}" />
          <input type="hidden" name="form_type" value="Interactive Client Tool Pilot" />
          <input type="hidden" name="inquiry_marker" value="ks-client-tool-pilot-v1" />
          <input type="hidden" name="source_page" value="/client-tool-pilot/" />
          <input type="hidden" name="offer_version" value="founding-0.1" />
          <input type="hidden" name="submitted_at" data-pilot-submitted-at value="" />

          <div class="form-honeypot" aria-hidden="true">
            <label for="pilot-company-name">Leave this field empty</label>
            <input id="pilot-company-name" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <header>
            <h2>{clientToolPilotFormConfigured ? "Apply for one of three complimentary builds" : "Applications are not open yet"}</h2>
            <p>{clientToolPilotFormConfigured
              ? "No call, account, upload, or new software. Applying does not guarantee selection."
              : "Review the short application below. The fields stay disabled until the founding pilot opens."}</p>
          </header>

          <p class="pilot-status" data-pilot-status data-state={clientToolPilotFormConfigured ? "ready" : "staged"} aria-live="polite">
            {clientToolPilotFormConfigured
              ? "Three complimentary founding builds are open. Applying does not guarantee selection."
              : "Applications are still closed while I finish and test the pilot system. Nothing can be submitted."}
          </p>

          <div class="pilot-field">
            <label for="pilot-url">Your website or public profile</label>
            <input id="pilot-url" name="public_url" type="url" inputmode="url" autocomplete="url" maxlength="500" placeholder="https://" required disabled={!clientToolPilotFormConfigured} />
          </div>

          <div class="pilot-field">
            <label for="pilot-question">The question potential clients keep asking</label>
            <textarea id="pilot-question" name="recurring_question" rows="3" minlength="12" maxlength="500" placeholder="How do I know if…?" required disabled={!clientToolPilotFormConfigured}></textarea>
          </div>

          <div class="pilot-field">
            <label for="pilot-next">Where should the right visitor go next?</label>
            <input id="pilot-next" name="next_action_url" type="url" inputmode="url" maxlength="500" placeholder="Booking, service, or contact URL" required disabled={!clientToolPilotFormConfigured} />
          </div>

          <div class="pilot-field">
            <label for="pilot-email">Your email</label>
            <input id="pilot-email" name="email" type="email" autocomplete="email" maxlength="254" required disabled={!clientToolPilotFormConfigured} />
          </div>

          <label class="pilot-confirm" for="pilot-authority">
            <input id="pilot-authority" name="authority_and_safety_confirmed" type="checkbox" value="Confirmed" required disabled={!clientToolPilotFormConfigured} />
            <span>I am authorized to submit this material, it contains no sensitive information, and I consent to a reply about this pilot. I will approve every claim before release. This does not add me to a mailing list.</span>
          </label>
          <input type="hidden" name="contact_consent" value="Consented" />

          <p class="pilot-no-obligation">There is no charge. You owe no positive review or public testimonial. Candid feedback is expected.</p>

          <p class="pilot-privacy">
            {clientToolPilotFormConfigured
              ? "Formspree sends the four fields above and your required authority and safety confirmation to Keith’s private inbox so he can evaluate and reply to this pilot. They are not used to add you to a mailing list."
              : "When applications open, Formspree will send the four fields above and your required authority and safety confirmation to Keith’s private inbox. Nothing is submitted while this page says applications are closed."}
            {" "}<a href="/privacy/">Read the privacy notice.</a>
          </p>

          <button class="pilot-submit" type="submit" disabled={!clientToolPilotFormConfigured}>
            <span data-pilot-submit-label>{clientToolPilotFormConfigured ? "Apply for a complimentary build" : "Applications not open"}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>

        </form>

        <section class="pilot-success" data-pilot-success hidden tabindex="-1" aria-labelledby="pilot-success-title">
          <h2 id="pilot-success-title">Your question is in.</h2>
          <p>Keith reviews every application. If it fits, the reply will confirm what he will build and which facts you must approve. Nothing is published without your approval.</p>
          <a href="/tools/first-ai-workflow/">Try the proof tool</a>
        </section>
      </div>
    </section>

    <section class="pilot-package" aria-labelledby="pilot-package-title">
      <div>
        <p>What comes back</p>
        <h2 id="pilot-package-title">A finished client tool, not another template to learn.</h2>
      </div>
      <ul>
        <li><strong>Build</strong><span>Only the questions the decision needs, never more than eight, with three or four tailored results</span></li>
        <li><strong>Launch</strong><span>Share image, three social posts, and one email draft</span></li>
        <li><strong>Handoff</strong><span>Private review link, quality checks, source files, and one correction</span></li>
      </ul>
    </section>

    <ol class="pilot-steps" aria-label="How the pilot works">
      <li><span>1</span><strong>You send the short brief</strong></li>
      <li><span>2</span><strong>I build and test it</strong></li>
      <li><span>3</span><strong>You approve the facts before launch</strong></li>
    </ol>

    <p class="pilot-boundary">This pilot is for straightforward, nonregulated client questions. It does not provide medical, legal, financial, employment, eligibility, crisis, or other high-stakes advice.</p>
  </div>
</MinimalStudio>

<script>
  import { track } from "@vercel/analytics";

  const pilotForm = document.querySelector<HTMLFormElement>("[data-client-tool-pilot-form]");
  const pilotStatus = document.querySelector<HTMLElement>("[data-pilot-status]");
  const pilotSuccess = document.querySelector<HTMLElement>("[data-pilot-success]");
  const pilotSubmit = pilotForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const pilotSubmitLabel = document.querySelector<HTMLElement>("[data-pilot-submit-label]");
  const submittedAt = document.querySelector<HTMLInputElement>("[data-pilot-submitted-at]");

  pilotForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!pilotForm.reportValidity() || !pilotStatus || !pilotSubmit || !pilotSubmitLabel) return;

    const configured = pilotForm.dataset.formConfigured === "true";
    const endpoint = pilotForm.getAttribute("action");
    if (!configured || !endpoint) {
      pilotStatus.dataset.state = "error";
      pilotStatus.textContent = "Applications are not open yet. Nothing was sent.";
      return;
    }

    if (submittedAt) submittedAt.value = new Date().toISOString();
    pilotForm.setAttribute("aria-busy", "true");
    pilotSubmit.disabled = true;
    pilotSubmitLabel.textContent = "Sending…";
    pilotStatus.dataset.state = "ready";
    pilotStatus.textContent = "Sending your idea…";

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        body: new FormData(pilotForm),
        headers: { Accept: "application/json" },
      });
      if (!response.ok) throw new Error("Pilot application failed");

      track("Client Tool Pilot Applied", { page: window.location.pathname });
      pilotForm.reset();
      pilotForm.hidden = true;
      if (pilotSuccess) {
        pilotSuccess.hidden = false;
        pilotSuccess.focus();
      }
    } catch {
      pilotStatus.dataset.state = "error";
      pilotStatus.textContent = "That did not send. Check your connection and try again. Your answers are still here.";
      pilotSubmit.disabled = false;
      pilotSubmitLabel.textContent = "Apply for a complimentary build";
    } finally {
      pilotForm.removeAttribute("aria-busy");
    }
  });
</script>

<style>
  .pilot-page {
    --pilot-max: 1480px;
    min-height: 100dvh;
    color: #f4f6fb;
  }

  .pilot-nav {
    width: min(calc(100% - 2.5rem), var(--pilot-max));
    min-height: 5.2rem;
    margin-inline: auto;
    border-bottom: 1px solid #303542;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pilot-brand {
    color: #f4f6fb;
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2vw, 2.2rem);
    font-weight: 650;
    text-decoration: none;
  }

  .pilot-nav nav {
    display: flex;
    gap: clamp(1.25rem, 4vw, 4rem);
  }

  .pilot-nav nav a {
    color: #f4f6fb;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .pilot-nav a:hover,
  .pilot-nav a:focus-visible { color: #6e8bff; }

  .pilot-hero {
    width: min(calc(100% - 2.5rem), var(--pilot-max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 550px;
    gap: 3rem;
    padding: clamp(2.5rem, 3.5vw, 3.4rem) clamp(0rem, 2.7vw, 2.5rem) 2.5rem;
    border-bottom: 1px solid #303542;
  }

  .pilot-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding-left: clamp(0rem, 4.8vw, 4.7rem);
  }

  .pilot-copy-inner { max-width: 760px; }

  .pilot-copy h1 {
    margin: 0;
    color: #f7f8fc;
    font-family: var(--font-serif);
    font-size: clamp(3.8rem, 5.4vw, 6.1rem);
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  .pilot-copy h1 em {
    color: #2851ff;
    font-weight: 600;
  }

  .pilot-eyebrow {
    margin: 0 0 1rem;
    color: #6e8bff;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .pilot-copy-inner > p:not(.pilot-eyebrow) {
    max-width: 650px;
    margin: 2rem 0 2.4rem;
    color: #c4c8d2;
    font-size: clamp(1.1rem, 1.55vw, 1.45rem);
    line-height: 1.55;
  }

  .pilot-primary,
  .pilot-submit {
    min-height: 4.2rem;
    border: 0;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 1rem 1.8rem;
    background: #ff604d;
    color: #050608;
    font: 720 0.95rem/1 var(--font-sans);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .pilot-primary { width: min(100%, 360px); }

  .pilot-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .pilot-secondary {
    border-bottom: 1px solid #5f80ff;
    padding: 0.55rem 0;
    color: #dfe4ff;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }

  .pilot-secondary:hover,
  .pilot-secondary:focus-visible { color: #7891ff; }
  .pilot-primary svg,
  .pilot-submit svg {
    width: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pilot-primary:hover,
  .pilot-primary:focus-visible,
  .pilot-submit:hover:not(:disabled),
  .pilot-submit:focus-visible:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 18px 50px rgb(255 96 77 / 0.24);
  }

  .pilot-proof {
    margin: clamp(2.5rem, 7vw, 7rem) 0 0;
    padding: 1.6rem 0 0;
    border-top: 1px solid #303542;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2rem;
    list-style: none;
  }

  .pilot-proof li {
    position: relative;
    padding-left: 1.2rem;
    color: #d8dae1;
    font-size: 0.88rem;
  }

  .pilot-proof li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.48em;
    width: 0.34rem;
    height: 0.34rem;
    border: 1px solid #2851ff;
    border-radius: 50%;
  }

  .pilot-form-wrap {
    align-self: start;
    border: 1px solid #2851ff;
    background: rgb(7 9 14 / 0.86);
  }

  .pilot-form { padding: clamp(1.6rem, 2.3vw, 2rem); }
  .pilot-form header { margin-bottom: 1.25rem; }

  .pilot-form h2,
  .pilot-success h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2vw, 2rem);
    letter-spacing: -0.03em;
  }

  .pilot-form header p,
  .pilot-success p {
    margin: 0.55rem 0 0;
    color: #a8abb7;
    line-height: 1.55;
  }

  .pilot-field { margin-top: 1rem; }
  .pilot-field label {
    display: block;
    margin-bottom: 0.55rem;
    color: #eef0f5;
    font-size: 0.88rem;
    font-weight: 590;
  }

  .pilot-field input,
  .pilot-field textarea {
    width: 100%;
    border: 1px solid #4a4f5c;
    border-radius: 0;
    padding: 0.75rem 0.9rem;
    background: #0b0e14;
    color: #f4f6fb;
    font: 500 1rem/1.45 var(--font-sans);
  }

  .pilot-field textarea { min-height: 5.4rem; resize: vertical; }
  .pilot-field input::placeholder,
  .pilot-field textarea::placeholder { color: #6d7280; }
  .pilot-field input:focus,
  .pilot-field textarea:focus { border-color: #2851ff; outline: none; }

  .pilot-field input:disabled,
  .pilot-field textarea:disabled {
    cursor: not-allowed;
    border-color: #323641;
    background: #080a0f;
    color: #777d89;
    opacity: 0.72;
  }

  .pilot-field input:disabled::placeholder,
  .pilot-field textarea:disabled::placeholder { color: #525864; }

  .pilot-confirm {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: 1.1rem 1fr;
    gap: 0.75rem;
    color: #aeb2bd;
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .pilot-confirm input {
    width: 1rem;
    height: 1rem;
    margin: 0.16rem 0 0;
    accent-color: #2851ff;
  }

  .pilot-no-obligation {
    margin: 1rem 0 0;
    border-left: 2px solid #ff604d;
    padding-left: 0.75rem;
    color: #d8dae1;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .pilot-status {
    margin: 1rem 0 1.2rem;
    border-left: 2px solid currentColor;
    padding-left: 0.75rem;
    color: #aeb2bd;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .pilot-status[data-state="error"] { color: #ff8d80; }
  .pilot-status[data-state="staged"] { color: #8ca3ff; }

  .pilot-submit {
    width: 100%;
    margin-top: 1.2rem;
    background: #2851ff;
    color: white;
    cursor: pointer;
  }

  .pilot-submit:disabled { cursor: not-allowed; opacity: 0.45; }

  .pilot-privacy {
    margin: 1rem 0 0;
    color: #7f8490;
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .pilot-privacy a { color: #a9b8ff; }
  .pilot-privacy a:hover,
  .pilot-privacy a:focus-visible { color: #dbe1ff; }

  .pilot-success { padding: 3rem; }
  .pilot-success a { display: inline-block; margin-top: 1.5rem; color: #7590ff; }

  .pilot-package {
    width: min(calc(100% - 2.5rem), var(--pilot-max));
    margin: 0 auto;
    border-bottom: 1px solid #303542;
    padding: clamp(2.6rem, 5vw, 4.5rem) clamp(0rem, 2.7vw, 2.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .pilot-package > div > p {
    margin: 0 0 0.85rem;
    color: #5f80ff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pilot-package h2 {
    margin: 0;
    color: #f4f6fb;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .pilot-package ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pilot-package li {
    border-top: 1px solid #303542;
    padding: 1.15rem 0;
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
  }

  .pilot-package li:last-child { border-bottom: 1px solid #303542; }
  .pilot-package strong { color: #f0f2f7; font-family: var(--font-serif); }
  .pilot-package span { color: #aeb2bd; line-height: 1.5; }

  .pilot-steps {
    width: min(calc(100% - 2.5rem), var(--pilot-max));
    margin: 0 auto;
    padding: 2.4rem clamp(0rem, 2.7vw, 2.5rem) 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    list-style: none;
  }

  .pilot-steps li {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    color: #e4e6ec;
  }

  .pilot-steps span {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #2851ff;
    display: grid;
    place-items: center;
    color: #6f8aff;
    font-family: var(--font-serif);
    font-size: 1.15rem;
  }

  .pilot-steps strong {
    font-family: var(--font-serif);
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
  }

  .pilot-boundary {
    width: min(calc(100% - 2.5rem), var(--pilot-max));
    margin: 0 auto;
    padding: 0 clamp(0rem, 2.7vw, 2.5rem) 2.4rem;
    color: #8f94a1;
    font-size: 0.86rem;
    line-height: 1.55;
  }

  @media (max-width: 1100px) {
    .pilot-hero {
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
    .pilot-copy { padding-left: 0; }
    .pilot-copy-inner { max-width: 820px; }
    .pilot-form-wrap { width: min(100%, 650px); }
    .pilot-proof { margin-top: 3rem; }
  }

  @media (max-width: 640px) {
    .pilot-nav { width: min(calc(100% - 2rem), var(--pilot-max)); min-height: 4.5rem; }
    .pilot-nav nav { gap: 1rem; }
    .pilot-nav nav a { font-size: 0.78rem; }
    .pilot-hero { width: min(calc(100% - 2rem), var(--pilot-max)); padding-top: 2.3rem; }
    .pilot-copy h1 { font-size: clamp(3.15rem, 15vw, 5rem); }
    .pilot-copy-inner > p { font-size: 1rem; }
    .pilot-primary { width: 100%; }
    .pilot-actions { display: grid; }
    .pilot-secondary { justify-self: start; }
    .pilot-proof { gap: 0.8rem; }
    .pilot-proof li { width: 100%; }
    .pilot-form { padding: 1.25rem; }
    .pilot-package {
      width: min(calc(100% - 2rem), var(--pilot-max));
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
    .pilot-package li { grid-template-columns: 5.5rem 1fr; }
    .pilot-steps {
      width: min(calc(100% - 2rem), var(--pilot-max));
      grid-template-columns: 1fr;
      padding-inline: 0;
    }
    .pilot-boundary {
      width: min(calc(100% - 2rem), var(--pilot-max));
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pilot-primary,
    .pilot-submit { transition: none; }
  }
</style>
