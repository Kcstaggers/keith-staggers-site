---
import MinimalStudio from "../layouts/MinimalStudio.astro";
import {
  clientToolPilotFormConfigured,
  clientToolPilotFormEndpoint,
} from "../data/clientToolPilot";
import { clientToolBySlug } from "../data/clientTools";

const proofTool = clientToolBySlug.get("first-ai-workflow");
if (!proofTool) throw new Error("First AI Task Finder proof configuration is missing");

const proofQuestion = proofTool.questions[0];
const proofOption = proofQuestion.options[0];
const proofOutcome = proofTool.outcomes.followup;
---

<MinimalStudio
  title="Three Complimentary Interactive Website Guide Builds"
  description="Keith builds a short, branded website guide that answers a recurring client question and points each visitor to the right next step."
  ogImage={proofTool.ogImage}
  ogImageAlt={proofTool.ogImageAlt}
>
  <div class="pilot-page" data-pilot-clarity-page>
    <header class="pilot-nav" aria-label="Founding build navigation">
      <a class="pilot-brand" href="/">Keith Staggers</a>
      <nav aria-label="Studio links">
        <a href="/">Studio</a>
        <a href="/#work">Work</a>
        <a href="/#notes">Notes</a>
      </nav>
    </header>

    <section class="pilot-hero" aria-labelledby="pilot-title">
      <div class="pilot-offer" data-pilot-offer>
        <p class="pilot-kicker">Done-for-you interactive website guides</p>
        <h1 id="pilot-title">I build a short website guide that answers the question your clients keep asking.</h1>
        <p class="pilot-lede">You send your website, the question, and the right next step. I build the questions, tailored results, launch kit, and handoff.</p>

        <a class="pilot-primary" href="/tools/first-ai-workflow/">
          Try the working example
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>

        {!clientToolPilotFormConfigured && (
          <aside class="pilot-closed" data-pilot-closed aria-label="Application status">
            <span>Applications are closed</span>
            <p>Three complimentary founding builds are planned. Nothing can be submitted while I finish testing. No positive review or testimonial is required.</p>
          </aside>
        )}
      </div>

      <section class="pilot-demo" data-pilot-example aria-labelledby="pilot-demo-title">
        <div class="pilot-demo-heading">
          <div>
            <p>Working example</p>
            <h2 id="pilot-demo-title">See a finished product in action.</h2>
          </div>
          <span>{proofTool.intro.duration}</span>
        </div>

        <div class="pilot-demo-stage">
          <div class="pilot-demo-main">
            <img
              class="pilot-demo-image"
              src={proofTool.ogImage}
              alt={proofTool.ogImageAlt}
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />

            <div class="pilot-demo-states">
              <section class="pilot-question-preview" aria-labelledby="pilot-question-preview-title">
                <p>Question 1 of {proofTool.questions.length}</p>
                <h3 id="pilot-question-preview-title">{proofQuestion.title}</h3>
                <span>{proofOption.label}</span>
              </section>

              <section class="pilot-result-preview" aria-labelledby="pilot-result-preview-title">
                <p>Example result</p>
                <h3 id="pilot-result-preview-title">{proofOutcome.title}</h3>
                <span>{proofOutcome.summary}</span>
              </section>
            </div>

            <a class="pilot-demo-link" href="/tools/first-ai-workflow/">
              Open the First AI Task Finder
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
            </a>
          </div>

          <aside class="pilot-delivery" aria-labelledby="pilot-delivery-title">
            <h3 id="pilot-delivery-title">Your delivery package</h3>
            <ul>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="0" /><path d="m7 15 3-3 2 2 3-4 2 3" /></svg>
                <span><strong>Share image</strong><small>Your tool in one visual</small></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v14H6z" /><path d="M3 7v14h12M9 7h6M9 11h6" /></svg>
                <span><strong>3 posts</strong><small>Ready-to-publish copy</small></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="0" /><path d="m4 7 8 6 8-6" /></svg>
                <span><strong>Email draft</strong><small>One launch email</small></span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18-6-6 6-6M15 6l6 6-6 6M14 3l-4 18" /></svg>
                <span><strong>Source + QA</strong><small>Files and verification notes</small></span>
              </li>
            </ul>
          </aside>
        </div>
      </section>
    </section>

    <section class="pilot-package" data-pilot-package aria-labelledby="pilot-package-title">
      <div class="pilot-package-heading">
        <p>What you receive</p>
        <h2 id="pilot-package-title">A complete guide you can launch.</h2>
      </div>

      <ul>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="0" /><path d="M3 8h18M7 6h.01M10 6h.01" /></svg>
          <span><strong>Interactive guide</strong><small>Tailored questions and results</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5Z" /><path d="m3 12 9 5 9-5M3 16l9 5 9-5" /></svg>
          <span><strong>Launch kit</strong><small>Share image, three posts, and an email</small></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M3 20v-2a5 5 0 0 1 10 0v2M16 11l2 2 4-5" /></svg>
          <span><strong>Private handoff</strong><small>Review link, source, QA, and one correction</small></span>
        </li>
      </ul>
    </section>

    {clientToolPilotFormConfigured && (
      <section class="pilot-intake" id="pilot-form" aria-labelledby="pilot-form-title">
        <form
          class="pilot-form"
          data-client-tool-pilot-form
          data-form-configured="true"
          action={clientToolPilotFormEndpoint}
          method="post"
          accept-charset="UTF-8"
        >
          <input type="hidden" name="subject" value="[KS Client Tool Pilot] {{ email }}" />
          <input type="hidden" name="form_type" value="Interactive Client Tool Pilot" />
          <input type="hidden" name="inquiry_marker" value="ks-client-tool-pilot-v1" />
          <input type="hidden" name="source_page" value="/client-tool-pilot/" />
          <input type="hidden" name="offer_version" value="founding-0.1" />
          <input type="hidden" name="submitted_at" data-pilot-submitted-at value="" />

          <div class="form-honeypot" aria-hidden="true">
            <label for="pilot-company-name">Leave this field empty</label>
            <input id="pilot-company-name" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <header>
            <p>Three complimentary founding builds</p>
            <h2 id="pilot-form-title">Apply with the short brief.</h2>
            <span>No call, account, upload, or new software. Applying does not guarantee selection.</span>
          </header>

          <p class="pilot-status" data-pilot-status data-state="ready" aria-live="polite">Applications are open.</p>

          <div class="pilot-field">
            <label for="pilot-url">Your website or public profile</label>
            <input id="pilot-url" name="public_url" type="url" inputmode="url" autocomplete="url" maxlength="500" placeholder="https://" required />
          </div>

          <div class="pilot-field">
            <label for="pilot-question">The question potential clients keep asking</label>
            <textarea id="pilot-question" name="recurring_question" rows="3" minlength="12" maxlength="500" placeholder="How do I know if…?" required></textarea>
          </div>

          <div class="pilot-field">
            <label for="pilot-next">Where should the right visitor go next?</label>
            <input id="pilot-next" name="next_action_url" type="url" inputmode="url" maxlength="500" placeholder="Booking, service, or contact URL" required />
          </div>

          <div class="pilot-field">
            <label for="pilot-email">Your email</label>
            <input id="pilot-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          </div>

          <label class="pilot-confirm" for="pilot-authority">
            <input id="pilot-authority" name="authority_and_safety_confirmed" type="checkbox" value="Confirmed" required />
            <span>I am authorized to submit this material, it contains no sensitive information, and I consent to a reply about this pilot. I will approve every claim before release. This does not add me to a mailing list.</span>
          </label>
          <input type="hidden" name="contact_consent" value="Consented" />

          <p class="pilot-no-obligation">There is no charge. You owe no positive review or public testimonial. Candid feedback is expected.</p>
          <p class="pilot-privacy">Formspree sends the four fields above and your required authority and safety confirmation to Keith’s private inbox so he can evaluate and reply to this pilot. They are not used to add you to a mailing list. <a href="/privacy/">Read the privacy notice.</a></p>

          <button class="pilot-submit" type="submit">
            <span data-pilot-submit-label>Apply for a complimentary build</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </button>
        </form>

      </section>
    )}

    <p class="pilot-boundary">Straightforward, nonregulated service questions only. No medical, legal, financial, tax, employment, eligibility, crisis, or other high-stakes advice.</p>
  </div>
</MinimalStudio>

<style>
  .pilot-page {
    --pilot-max: 1440px;
    min-height: 100dvh;
    color: #f4f6fb;
  }

  .pilot-nav {
    width: min(calc(100% - 5.5rem), var(--pilot-max));
    min-height: 5.2rem;
    margin-inline: auto;
    border-bottom: 1px solid #303542;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pilot-brand {
    color: #f4f6fb;
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2vw, 2.2rem);
    font-weight: 650;
    text-decoration: none;
  }

  .pilot-nav nav { display: flex; gap: clamp(1.25rem, 4vw, 4rem); }

  .pilot-nav nav a {
    color: #f4f6fb;
    font-size: 0.9rem;
    text-decoration: none;
  }

  .pilot-nav a:hover,
  .pilot-nav a:focus-visible { color: #6e8bff; }

  .pilot-hero {
    width: min(calc(100% - 5.5rem), var(--pilot-max));
    margin-inline: auto;
    border-bottom: 1px solid #303542;
    padding-block: clamp(2.8rem, 4.5vw, 4.5rem);
    display: grid;
    grid-template-columns: minmax(320px, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(2.5rem, 4vw, 4.5rem);
    align-items: start;
  }

  .pilot-offer { min-width: 0; padding-top: 0.5rem; }

  .pilot-kicker,
  .pilot-demo-heading p,
  .pilot-question-preview > p,
  .pilot-result-preview > p,
  .pilot-package-heading > p,
  .pilot-form header > p {
    margin: 0;
    color: #6e8bff;
    font-size: 0.76rem;
    font-weight: 720;
    letter-spacing: 0.1em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .pilot-offer h1 {
    max-width: 15.5ch;
    margin: 1.05rem 0 0;
    color: #f7f8fc;
    font-family: var(--font-serif);
    font-size: clamp(2.9rem, 3.75vw, 4.35rem);
    font-weight: 560;
    letter-spacing: -0.047em;
    line-height: 0.97;
  }

  .pilot-lede {
    max-width: 36rem;
    margin: 1.65rem 0 2rem;
    color: #b8bcc7;
    font-size: clamp(1.05rem, 1.3vw, 1.24rem);
    line-height: 1.58;
  }

  .pilot-primary,
  .pilot-submit {
    width: min(100%, 22rem);
    min-height: 4rem;
    border: 0;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1rem 1.45rem;
    background: #ff604d;
    color: #050608;
    font: 720 0.92rem/1 var(--font-sans);
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .pilot-primary svg,
  .pilot-submit svg,
  .pilot-demo-link svg {
    width: 1.35rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pilot-primary:hover,
  .pilot-primary:focus-visible,
  .pilot-submit:hover,
  .pilot-submit:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 18px 50px rgb(255 96 77 / 0.22);
  }

  .pilot-closed {
    max-width: 34rem;
    margin-top: 1.65rem;
    border-left: 2px solid #2851ff;
    padding: 0.15rem 0 0.15rem 0.95rem;
  }

  .pilot-closed span {
    color: #dfe4ff;
    font-size: 0.78rem;
    font-weight: 720;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pilot-closed p {
    margin: 0.35rem 0 0;
    color: #8f95a3;
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .pilot-demo { min-width: 0; }

  .pilot-demo-heading {
    min-height: 3.6rem;
    margin-bottom: 1.15rem;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .pilot-demo-heading h2 {
    margin: 0.3rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 2.3vw, 2.55rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .pilot-demo-heading > span {
    color: #8f95a3;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.4;
    text-align: right;
  }

  .pilot-demo-stage {
    border: 1px solid #2851ff;
    background: rgb(7 9 14 / 0.9);
    display: grid;
    grid-template-columns: minmax(0, 2.35fr) minmax(12.5rem, 0.85fr);
  }

  .pilot-demo-main { min-width: 0; }

  .pilot-demo-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    display: block;
    border-bottom: 1px solid #303542;
    object-fit: contain;
    background: #050608;
  }

  .pilot-demo-states {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  }

  .pilot-question-preview,
  .pilot-result-preview {
    min-width: 0;
    margin: 0;
    padding: 1rem;
  }

  .pilot-question-preview { border-right: 1px solid #303542; background: #0b0e14; }
  .pilot-result-preview { background: #f4f6fb; color: #050608; }
  .pilot-result-preview > p { color: #2851ff; }

  .pilot-question-preview h3,
  .pilot-result-preview h3 {
    margin: 0.55rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.35vw, 1.3rem);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .pilot-question-preview > span {
    margin-top: 0.8rem;
    border: 1px solid #4a5270;
    padding: 0.55rem 0.65rem;
    display: block;
    color: #cdd3e5;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .pilot-result-preview > span {
    margin-top: 0.65rem;
    display: block;
    color: #4d5360;
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .pilot-demo-link {
    min-height: 3.4rem;
    border-top: 1px solid #303542;
    padding: 0.8rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #dce3ff;
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
  }

  .pilot-demo-link:hover,
  .pilot-demo-link:focus-visible { background: #2851ff; color: #fff; }

  .pilot-delivery {
    min-width: 0;
    border-left: 1px solid #303542;
    padding: 1.15rem;
  }

  .pilot-delivery h3 {
    margin: 0;
    color: #8ca3ff;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .pilot-delivery ul { margin: 1.05rem 0 0; padding: 0; list-style: none; }

  .pilot-delivery li {
    min-width: 0;
    border-top: 1px solid #303542;
    padding: 0.88rem 0;
    display: grid;
    grid-template-columns: 1.3rem minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
  }

  .pilot-delivery li:last-child { border-bottom: 1px solid #303542; }
  .pilot-delivery svg,
  .pilot-package li > svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pilot-delivery svg { color: #7e8594; }
  .pilot-delivery span,
  .pilot-package li > span { min-width: 0; display: grid; gap: 0.25rem; }
  .pilot-delivery strong { color: #f1f3f8; font-size: 0.78rem; }
  .pilot-delivery small { color: #8f95a3; font-size: 0.68rem; line-height: 1.35; }

  .pilot-package {
    width: min(calc(100% - 5.5rem), var(--pilot-max));
    margin-inline: auto;
    border-bottom: 1px solid #303542;
    padding-block: clamp(2.4rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(16rem, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
  }

  .pilot-package-heading h2 {
    max-width: 12ch;
    margin: 0.6rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.2vw, 3.4rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .pilot-package > ul {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
  }

  .pilot-package li {
    min-width: 0;
    min-height: 7.5rem;
    border-left: 1px solid #303542;
    padding: 0.25rem 1.3rem;
    display: grid;
    grid-template-columns: 1.45rem minmax(0, 1fr);
    gap: 0.75rem;
    align-content: center;
  }

  .pilot-package li > svg { color: #5f80ff; }
  .pilot-package strong { color: #f0f2f7; font-family: var(--font-serif); font-size: 1rem; }
  .pilot-package small { color: #8f95a3; font-size: 0.74rem; line-height: 1.45; }

  .pilot-intake {
    width: min(calc(100% - 2.5rem), 42rem);
    margin: 3.5rem auto;
    border: 1px solid #2851ff;
    background: rgb(7 9 14 / 0.9);
  }

  .pilot-form { padding: clamp(1.5rem, 3vw, 2.25rem); }
  .pilot-form header { margin-bottom: 1.25rem; }
  .pilot-form h2,
  .pilot-success h2 { margin: 0.4rem 0 0; font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -0.03em; }
  .pilot-form header > span,
  .pilot-success p { margin-top: 0.55rem; display: block; color: #a8abb7; line-height: 1.55; }
  .pilot-field { margin-top: 1rem; }
  .pilot-field label { margin-bottom: 0.55rem; display: block; color: #eef0f5; font-size: 0.88rem; font-weight: 590; }
  .pilot-field input,
  .pilot-field textarea { width: 100%; border: 1px solid #4a4f5c; border-radius: 0; padding: 0.75rem 0.9rem; background: #0b0e14; color: #f4f6fb; font: 500 1rem/1.45 var(--font-sans); }
  .pilot-field textarea { min-height: 5.4rem; resize: vertical; }
  .pilot-field input::placeholder,
  .pilot-field textarea::placeholder { color: #6d7280; }
  .pilot-field input:focus,
  .pilot-field textarea:focus { border-color: #2851ff; outline: none; }
  .pilot-confirm { margin-top: 1rem; display: grid; grid-template-columns: 1.1rem 1fr; gap: 0.75rem; color: #aeb2bd; font-size: 0.76rem; line-height: 1.5; }
  .pilot-confirm input { width: 1rem; height: 1rem; margin: 0.16rem 0 0; accent-color: #2851ff; }
  .pilot-no-obligation { margin: 1rem 0 0; border-left: 2px solid #ff604d; padding-left: 0.75rem; color: #d8dae1; font-size: 0.78rem; line-height: 1.5; }
  .pilot-status { margin: 1rem 0 1.2rem; border-left: 2px solid currentColor; padding-left: 0.75rem; color: #8ca3ff; font-size: 0.82rem; line-height: 1.45; }
  .pilot-status[data-state="error"] { color: #ff8d80; }
  .pilot-submit { width: 100%; margin-top: 1.2rem; background: #2851ff; color: white; cursor: pointer; }
  .pilot-privacy { margin: 1rem 0 0; color: #7f8490; font-size: 0.72rem; line-height: 1.5; }
  .pilot-privacy a { color: #a9b8ff; }
  .pilot-success { padding: 3rem; }
  .pilot-success a { margin-top: 1.5rem; display: inline-block; color: #7590ff; }

  .pilot-boundary {
    width: min(calc(100% - 5.5rem), var(--pilot-max));
    margin: 0 auto;
    border-left: 2px solid #2851ff;
    padding: 1.4rem 0 1.4rem 1rem;
    color: #858b99;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (max-width: 1100px) {
    .pilot-hero { grid-template-columns: 1fr; }
    .pilot-offer h1 { max-width: 17ch; }
    .pilot-lede { max-width: 45rem; }
    .pilot-demo { margin-top: 0.5rem; }
  }

  @media (max-width: 760px) {
    .pilot-demo-stage { grid-template-columns: 1fr; }
    .pilot-delivery { border-top: 1px solid #303542; border-left: 0; }
    .pilot-delivery ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pilot-delivery li:nth-child(2) { border-top: 1px solid #303542; }
    .pilot-delivery li:nth-last-child(-n + 2) { border-bottom: 1px solid #303542; }
    .pilot-package { grid-template-columns: 1fr; }
    .pilot-package-heading h2 { max-width: none; }
  }

  @media (max-width: 640px) {
