---
import Base from "../../layouts/Base.astro";
import { publishedNotes, type StudioNote } from "../../data/notes";
import { site } from "../../data/site";
import { getBookingHref, getCalAttrs } from "../../utils/booking";

export function getStaticPaths() {
  return publishedNotes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

interface Props {
  note: StudioNote;
}

const { note } = Astro.props;
const href = getBookingHref();
const calAttrs = getCalAttrs();
const canonicalUrl = new URL(`/notes/${note.slug}/`, site.url).href;
const imageUrl = new URL(note.image.src, site.url).href;
const articleBodyText = note.articleBodyHtml
  ?.replace(/<[^>]+>/g, " ")
  .replace(/\s+/g, " ")
  .trim();
const wordCount = articleBodyText
  ? articleBodyText.split(/\s+/).length
  : note.sections.reduce(
      (total, section) =>
        total +
        section.heading.split(/\s+/).length +
        section.paragraphs.reduce((count, paragraph) => count + paragraph.split(/\s+/).length, 0),
      note.summary.split(/\s+/).length +
        note.keyPoints.reduce((count, point) => count + point.split(/\s+/).length, 0)
    );
const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${value}T00:00:00Z`));
const relatedNotes = note.relatedNoteSlugs
  .map((slug) => publishedNotes.find((candidate) => candidate.slug === slug))
  .filter((candidate): candidate is StudioNote => Boolean(candidate))
  .slice(0, 3);
const articleJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `${canonicalUrl}#article`,
      headline: note.title,
      description: note.excerpt,
      mainEntityOfPage: canonicalUrl,
      url: canonicalUrl,
      datePublished: note.datePublished,
      dateModified: note.dateModified,
      articleSection: note.category,
      keywords: note.tags.join(", "),
      wordCount,
      timeRequired: `PT${Number.parseInt(note.readingTime, 10)}M`,
      isAccessibleForFree: true,
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/notes/#blog` },
      author: {
        "@type": "Person",
        "@id": `${site.url}/#keith`,
        name: site.name,
        url: `${site.url}/about/`,
      },
      publisher: { "@id": `${site.url}/#studio` },
      image: {
        "@type": "ImageObject",
        url: imageUrl,
        width: note.image.width,
        height: note.image.height,
        caption: note.image.alt,
      },
      thumbnailUrl: imageUrl,
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Articles and Guides",
          item: `${site.url}/notes/`,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: note.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<Base
  title={note.seoTitle}
  description={note.excerpt}
  ogType="article"
  ogImage={note.image.src}
  ogImageAlt={note.image.alt}
  ogImageWidth={note.image.width}
  ogImageHeight={note.image.height}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={note.datePublished} />
    <meta property="article:modified_time" content={note.dateModified} />
    <meta property="article:author" content={`${site.url}/about/`} />
    <meta property="article:section" content={note.category} />
    {note.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  </Fragment>

  <article class="px-6 lg:px-12 pt-12 pb-20 lg:pt-20 lg:pb-28 max-w-[1280px] mx-auto">
    <nav class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint" aria-label="Breadcrumb">
      <a href="/" class="hover:text-paper transition-colors">Home</a>
      <span class="text-rule mx-2" aria-hidden="true">/</span>
      <a href="/notes/" class="hover:text-paper transition-colors">Articles and Guides</a>
      <span class="text-rule mx-2" aria-hidden="true">/</span>
      <span class="text-cobalt-text" aria-current="page">{note.number}</span>
    </nav>

    <header class="grid lg:grid-cols-12 gap-10 lg:gap-16 pb-16 lg:pb-24">
      <div class="lg:col-span-9">
        <p class="eyebrow mb-7">Article · {note.number} / {note.category}</p>
        <h1 class="serif text-[clamp(46px,7vw,96px)] leading-[0.96] tracking-[-0.04em]">
          {note.title}
        </h1>
      </div>
      <div class="lg:col-span-3 lg:self-end">
        <p class="font-mono text-[10px] tracking-[0.16em] uppercase text-paper-faint mb-3">{note.readingTime}</p>
        <p class="serif italic text-[19px] leading-[1.5] text-paper-dim">By <a href="/about/" rel="author" class="underline decoration-rule underline-offset-4 hover:text-paper">Keith Staggers</a></p>
        <p class="mt-3 font-mono text-[10px] leading-[1.7] tracking-[0.1em] uppercase text-paper-faint">
          Published <time datetime={note.datePublished}>{formatDate(note.datePublished)}</time>
          {note.dateModified !== note.datePublished && <><br />Updated <time datetime={note.dateModified}>{formatDate(note.dateModified)}</time></>}
        </p>
      </div>
    </header>

    <figure class="mb-16 overflow-hidden border border-rule bg-panel lg:mb-24">
      <img
        src={note.image.src}
        alt={note.image.alt}
        width={note.image.width}
        height={note.image.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full"
      />
    </figure>

    <div class="hairline pt-12 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <aside class="lg:col-span-3">
        <p class="serif italic text-[21px] leading-[1.55] text-paper-dim lg:sticky lg:top-28">
          {note.excerpt}
        </p>
      </aside>

      <div class="lg:col-span-7 lg:col-start-5">
        {note.keyPoints.length > 0 && (
          <section class="mb-16 border border-rule bg-panel/60 p-6 sm:p-8" aria-labelledby="note-in-brief">
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">In brief</p>
            <h2 id="note-in-brief" class="mt-4 serif text-[28px] leading-tight">{note.answerHeading}</h2>
            <p class="mt-4 text-[17px] leading-[1.7] text-paper-dim">{note.summary}</p>
            <ul class="mt-6 space-y-3">
              {note.keyPoints.map((point) => (
                <li class="flex gap-3 text-[15px] leading-[1.65] text-paper/85">
                  <span class="text-cobalt-text" aria-hidden="true">→</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
        {note.articleBodyHtml ? (
          <div set:html={note.articleBodyHtml} />
        ) : (
          note.sections.map((section, index) => (
            <section class:list={["note-section", index > 0 && "mt-16 pt-12 border-t border-rule/70"]}>
              <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text mb-4">
                {String(index + 1).padStart(2, "0")}
              </p>
              <h2 class="serif text-[clamp(30px,3.6vw,46px)] leading-[1.04] tracking-[-0.02em] mb-7">
                {section.heading}
              </h2>
              {section.paragraphs.map((paragraph) => (
                <p class="serif text-[18px] lg:text-[20px] leading-[1.72] text-paper/90 mb-6 last:mb-0">
                  {paragraph}
                </p>
              ))}
            </section>
          ))
        )}

        {note.resources.length > 0 && (
          <section class="mt-16 border-t border-rule/70 pt-12" aria-labelledby="note-resources-title">
            <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-cobalt-text">What to do next</p>
            <h2 id="note-resources-title" class="mt-4 serif text-[32px] leading-tight">Related resources and services.</h2>
            <ul class="mt-7 space-y-5">
              {note.resources.map((resource) => (
                <li>
                  <a href={resource.href} class="group block border-l-2 border-cobalt pl-5">
                    <strong class="block text-[16px] text-paper transition-colors group-hover:text-cobalt-text">{resource.title} →</strong>
                    <span class="mt-1 block text-[14px] leading-[1.6] text-paper-dim">{resource.context}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>

    {note.showCallout !== false && <section class="mt-24 lg:mt-32 bg-paper text-ink p-8 sm:p-12 lg:p-16 grid lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8">
        <p class="font-mono text-[10px] tracking-[0.18em] uppercase text-ink/55 mb-5">Use this idea</p>
        <h2 class="serif text-[clamp(36px,5vw,64px)] leading-[0.98] tracking-[-0.03em]">
          {note.ctaHeading}
        </h2>
      </div>
      <div class="lg:col-span-4 lg:text-right">
        <a
          href={note.related.href}
          class="block mb-4 text-[12px] font-mono tracking-[0.12em] uppercase text-ink/65 hover:text-cobalt transition-colors"
        >
          See {note.related.title} →
        </a>
        <a
          href={href}
          {...calAttrs}
          class="inline-flex items-center gap-3 bg-cobalt text-white px-6 py-4 font-mono text-[11px] tracking-[0.1em] uppercase hover:bg-cobalt-dim transition-colors"
        >
          {note.primaryCtaLabel} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>}

    <section class="hairline mt-16 pt-10" aria-labelledby="related-notes-title">
      <h2 id="related-notes-title" class="eyebrow mb-6">Keep reading</h2>
      <div class="grid gap-px bg-rule/60 md:grid-cols-2">
        {relatedNotes.map((related) => (
          <a
            href={`/notes/${related.slug}/`}
            class="bg-ink p-6 transition-colors hover:bg-paper/[0.04] focus-visible:bg-paper/[0.04]"
          >
            <span class="font-mono text-[10px] tracking-[0.16em] uppercase text-cobalt-text">
              Note {related.number} · {related.category}
            </span>
            <strong class="mt-3 block serif text-[22px] leading-tight">{related.title}</strong>
          </a>
        ))}
      </div>
    </section>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-5 font-mono text-[10px] tracking-[0.15em] uppercase text-paper-faint">
      <a href="/notes/" class="hover:text-paper transition-colors">← All articles and guides</a>
      <a href={site.social.facebook} target="_blank" rel="noreferrer" class="hover:text-paper transition-colors">Follow Keith on Facebook</a>
    </div>
  </article>
</Base>
