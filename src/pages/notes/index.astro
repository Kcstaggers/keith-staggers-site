---
import Base from "../../layouts/Base.astro";
import { publishedNotes } from "../../data/notes";
import { site } from "../../data/site";

const canonicalUrl = `${site.url}/notes/`;
const orderedNotes = [...publishedNotes].sort(
  (a, b) => b.datePublished.localeCompare(a.datePublished) || b.number.localeCompare(a.number)
);
const latestModified = orderedNotes.reduce(
  (latest, note) => (note.dateModified > latest ? note.dateModified : latest),
  "1970-01-01"
);
const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${value}T00:00:00Z`));
const notesJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["CollectionPage", "Blog"],
      "@id": `${canonicalUrl}#blog`,
      name: "Practical AI Articles and Guides by Keith Staggers",
      description:
        "Plain-English articles from Keith Staggers about using AI at work, team training, finishing projects, and professional reinvention.",
      url: canonicalUrl,
      dateModified: latestModified,
      inLanguage: "en-US",
      isPartOf: { "@id": `${site.url}/#website` },
      author: { "@id": `${site.url}/#keith` },
      publisher: { "@id": `${site.url}/#studio` },
      mainEntity: { "@id": `${canonicalUrl}#list` },
      blogPost: orderedNotes.map((note) => ({ "@id": `${site.url}/notes/${note.slug}/#article` })),
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#list`,
      numberOfItems: orderedNotes.length,
      itemListElement: orderedNotes.map((note, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: note.title,
        url: `${site.url}/notes/${note.slug}/`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: `${site.url}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Articles and Guides",
          item: canonicalUrl,
        },
      ],
    },
  ],
};

const startingPoints = [
  {
    problem: "Only the person who built the AI process can use it.",
    move: "Learn how to teach someone else to use it, stop it, and handle a failure.",
    href: "/notes/ai-workflow-handoff-run-stop-recover/",
  },
  {
    problem: "A project keeps producing drafts but never gets finished.",
    move: "Learn how to define a finished result before asking AI for more ideas.",
    href: "/notes/the-finishing-problem/",
  },
  {
    problem: "People attend AI training but do not use it afterward.",
    move: "Learn how to connect training to a task people face on the next workday.",
    href: "/notes/the-monday-morning-test/",
  },
];
---

<Base
  title="Practical AI Articles and Guides"
  description="Plain-English articles from Keith Staggers about using AI at work, team training, finishing projects, and professional reinvention."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(notesJsonLd)} />
  </Fragment>

  <article class="px-6 pb-20 pt-10 lg:px-12 lg:pb-28 lg:pt-16">
    <div class="mx-auto max-w-[1280px]">
      <nav class="mb-12 font-mono text-[11px] tracking-[0.18em] uppercase text-paper-faint" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-paper">Home</a>
        <span class="mx-2 text-rule" aria-hidden="true">/</span>
        <span class="text-cobalt-text" aria-current="page">Articles and Guides</span>
      </nav>

      <header class="grid gap-10 border-b border-rule pb-16 lg:grid-cols-12 lg:pb-24">
        <div class="lg:col-span-9">
          <p class="studio-kicker">Articles and guides</p>
          <h1 class="studio-display mt-6 text-[clamp(52px,8vw,112px)] leading-[0.92] tracking-[-0.055em]">
            Practical help<br /><strong>you can use</strong><span class="text-signal">.</span>
          </h1>
        </div>
        <p class="self-end text-[18px] leading-[1.7] text-paper-dim lg:col-span-3">
          Plain-English articles about using AI at work, training a team, finishing projects, and changing careers. Each article explains the problem, gives an example, and points to a useful next step.
        </p>
      </header>

      <section class="border-b border-rule py-16 lg:py-24" aria-labelledby="all-notes-title">
        <div class="mb-10 flex items-end justify-between gap-5">
          <div>
            <p class="studio-kicker">All articles</p>
            <h2 id="all-notes-title" class="studio-display mt-4 text-[clamp(34px,4vw,58px)]">Choose a problem you <strong>recognize</strong><span class="text-signal">.</span></h2>
          </div>
          <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-paper-faint">{orderedNotes.length} published articles</span>
        </div>

        <div class="divide-y divide-rule border-y border-rule">
          {orderedNotes.map((note) => (
            <article class="grid gap-7 py-9 lg:grid-cols-[72px_minmax(0,1fr)_220px] lg:items-start">
              <span class="font-mono text-[12px] tracking-[0.16em] text-cobalt-text">{note.number}</span>
              <div class="grid gap-6 sm:grid-cols-[160px_minmax(0,1fr)]">
                <div class="overflow-hidden border border-rule bg-panel">
                  <img src={note.image.src} alt={note.image.alt} width={note.image.width} height={note.image.height} loading="lazy" decoding="async" class="aspect-[1.9/1] h-full w-full object-cover" />
                </div>
                <div>
                  <p class="font-mono text-[10px] tracking-[0.14em] uppercase text-paper-faint">
                    {note.category} · {note.readingTime} · <time datetime={note.datePublished}>{formatDate(note.datePublished)}</time>
                  </p>
                  <h3 class="mt-4 serif text-[clamp(28px,3.5vw,46px)] leading-[1.02]">
                    <a href={`/notes/${note.slug}/`} class="transition-colors hover:text-cobalt">{note.title}</a>
                  </h3>
                  <p class="mt-4 max-w-[760px] text-[16px] leading-[1.7] text-paper-dim">{note.excerpt}</p>
                </div>
              </div>
              <div class="lg:text-right">
                <a href={`/notes/${note.slug}/`} class="block font-mono text-[11px] tracking-[0.12em] uppercase text-paper hover:text-cobalt-text">Read article →</a>
                <a href={note.related.href} class="mt-4 block font-mono text-[10px] leading-[1.5] tracking-[0.1em] uppercase text-paper-faint hover:text-paper">
                  Next step: {note.related.title} →
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="grid gap-10 border-b border-rule py-16 lg:grid-cols-12 lg:py-24" aria-labelledby="start-title">
        <div class="lg:col-span-4">
          <p class="studio-kicker">Not sure where to begin?</p>
          <h2 id="start-title" class="studio-display mt-5 text-[clamp(36px,4vw,60px)] leading-[1]">
            Start with the problem in <strong>front of you</strong><span class="text-signal">.</span>
          </h2>
        </div>
        <div class="grid gap-px bg-rule/70 lg:col-span-8">
          {startingPoints.map((item, index) => (
            <a href={item.href} class="grid gap-3 bg-ink p-6 transition-colors hover:bg-paper/[0.04] sm:grid-cols-[48px_minmax(0,1fr)]">
              <span class="font-mono text-[10px] text-cobalt-text">{String(index + 1).padStart(2, "0")}</span>
              <span>
                <strong class="block serif text-[24px]">{item.problem}</strong>
                <span class="mt-2 block text-[15px] leading-[1.6] text-paper-dim">{item.move}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <section class="grid items-end gap-10 pt-16 lg:grid-cols-12 lg:pt-24">
        <div class="lg:col-span-7">
          <p class="studio-kicker">Choose what to do next</p>
          <h2 class="studio-display mt-5 text-[clamp(40px,5.5vw,76px)] leading-[0.96]">
            Use the idea on a <strong>real task</strong><span class="text-signal">.</span>
          </h2>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
          <a href="/workflow-readiness/" class="studio-button studio-button--primary">See if a task is ready for AI</a>
          <a href="/finish-loop/" class="studio-button studio-button--secondary">Use the project-finishing toolkit</a>
          <a href="/services/" class="studio-button studio-button--secondary">See how Keith can help</a>
          <a href="/proof/" class="studio-button studio-button--secondary">See examples</a>
        </div>
      </section>
    </div>
  </article>
</Base>
