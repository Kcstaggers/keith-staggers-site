---
const paths = [
  {
    number: "01",
    label: "Build it for me",
    title: "Done-for-you AI setup",
    detail: "Choose one task your team repeats. Keith builds a practical AI-assisted process, tests it, documents it, and teaches your team how to use it.",
    price: "Projects from $2,500",
    href: "/services/done-for-you/",
    cta: "See the done-for-you service",
  },
  {
    number: "02",
    label: "Help me one-to-one",
    title: "One-to-one AI working session",
    detail: "Solve one real problem. Bring one task, business problem, or stuck project. Work with Keith for 60 minutes and leave with a useful first version and a written next-step plan.",
    price: "$250 · 60 minutes",
    href: "/services/coaching/",
    cta: "See the one-to-one session",
  },
  {
    number: "03",
    label: "Train my team",
    title: "Practical AI training",
    detail: "Your team practices using AI on recognizable work. People leave knowing what AI can help with, what they must check, and what to do next.",
    price: "Public class $179 · Team workshops from $3,500",
    href: "/services/training/",
    cta: "See the training options",
    secondaryHref: "/frontline-nurse-leader/",
    secondaryCta: "Nurse leader? See the September class",
  },
  {
    number: "04",
    label: "Bring Keith to my event",
    title: "AI speaking for leaders and teams",
    detail: "Book a practical talk about using AI safely at work, leading through change, or changing careers without losing what you already know.",
    price: "Keynotes from $3,500",
    href: "/services/speaking/",
    cta: "See speaking topics and formats",
  },
];
---

<section id="services" class="studio-section studio-services scroll-mt-24" aria-labelledby="studio-services-title">
  <div class="studio-shell">
    <div class="studio-services-head">
      <h2 id="studio-services-title" class="studio-display studio-section-title">Choose the help<br /><strong>you need</strong><span class="text-signal">.</span></h2>
      <p>
        You do not need to know the right AI term. Start with what you want to make easier.
        <a href="/services/" class="mt-4 block text-cobalt-text transition-colors hover:text-paper">Compare every option →</a>
      </p>
    </div>

    <div class="service-clarity-grid">
      {paths.map((path) => (
        <article class="service-clarity-card">
          <div class="service-clarity-meta">
            <span>{path.number}</span>
            <b>{path.label}</b>
          </div>
          <h3 class="studio-display">{path.title}</h3>
          <p>{path.detail}</p>
          <div class="service-clarity-action">
            <span>{path.price}</span>
            <a href={path.href}>{path.cta}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg></a>
            {path.secondaryHref && <a class="service-secondary" href={path.secondaryHref}>{path.secondaryCta}</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
