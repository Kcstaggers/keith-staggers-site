---
import { site } from "../data/site";
import OrbitalPortrait from "./OrbitalPortrait.astro";

const ctaHref = site.booking.intakePath;
---

<section class="studio-hero" aria-labelledby="studio-hero-title">
  <div class="studio-shell studio-hero-grid">
    <div class="studio-hero-copy">
      <h1 id="studio-hero-title" class="studio-display studio-hero-title">
        <span>Practical AI help</span>
        <span><strong>for real</strong></span>
        <span>work<span class="text-signal">.</span></span>
      </h1>

      <p class="studio-hero-support">
        I help leaders and small teams use AI to save time. I can build a solution for a repetitive task, work through one problem with you, or train your team.
      </p>

      <div class="studio-actions">
        <a
          href="/services/"
          class="studio-button studio-button--primary"
        >
          See how I can help
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
        <a
          href={ctaHref}
          class="studio-button studio-button--secondary"
        >
          Tell me about your task
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <p class="studio-proof-line">
        <span>Working nurse leader</span><i></i><span>Retired Baltimore detective</span><i></i><span>Author</span><i></i><span>Hands-on AI builder</span>
      </p>
    </div>

    <div class="studio-hero-portrait">
      <OrbitalPortrait eager />
      <p class="portrait-caption">Keith Staggers · AI trainer and builder</p>
    </div>
  </div>

  <div class="production-ticker">
    <p class="sr-only">Keith's approach: choose one task, decide what AI should do, build it, test it, and teach the team.</p>
    <div class="production-ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <span aria-hidden="true">
          <b>Build the workflow. Keep the judgment.</b><i>Choose one task</i><em>→</em><i>Set the boundaries</i><em>→</em><i>Build</i><em>→</em><i>Test</i><em>→</em><i>Teach the team</i><em>→</em>
        </span>
      ))}
    </div>
  </div>
</section>
