---
import { site } from "../data/site";

const ctaHref = site.booking.intakePath;
---

<section class="studio-hero v8-hero" aria-labelledby="studio-hero-title">
  <div class="v8-hero-stage">
    <div class="studio-shell v8-hero-inner">
      <div class="v8-hero-copy">
        <p class="v8-hero-label">Practical AI help for real work.</p>
        <h1 id="studio-hero-title" class="studio-display v8-hero-title">
          Make AI useful<br />
          in your <strong>real life</strong><span class="text-signal">.</span>
        </h1>

        <p class="v8-hero-intro">
          I help leaders and small teams use AI to save time. I built my own AI system to organize work, create more, and finish what I start. Now I turn those lessons into practical training, one-to-one sessions, and systems built for people and teams.
        </p>

        <div class="studio-actions v8-hero-actions">
          <a href="/services/" class="studio-button studio-button--primary">
            See how I can help
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </a>
          <a href="/proof/" class="studio-button studio-button--secondary">
            See real examples
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </a>
        </div>

        <p class="studio-proof-line v8-hero-proof">
          <span>Working nurse leader</span><i></i><span>Retired Baltimore detective</span><i></i><span>Author</span><i></i><span>Hands-on AI builder</span>
        </p>

        <a href={ctaHref} class="v8-hero-contact">Tell me about your task <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="v8-hero-media">
      <img
        src="/media/keith-hero-v8.webp"
        alt="Keith Staggers in a dark studio portrait with cobalt and coral light"
        width="1586"
        height="992"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <span class="v8-hero-signal" aria-hidden="true"></span>
      <p>Keith Staggers · AI trainer and builder</p>
    </div>
  </div>

  <div class="production-ticker">
    <p class="sr-only">Build a clear workflow, keep human approval, test failures, and record proof.</p>
    <div class="production-ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <span aria-hidden="true">
          <b>Build the workflow. Keep the judgment.</b><i>Clear sources</i><em>→</em><i>Human approval</i><em>→</em><i>Tested recovery</i><em>→</em><i>Real proof</i><em>→</em>
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .v8-hero {
    overflow: visible;
  }

  .v8-hero-stage {
    position: relative;
    min-height: clamp(600px, calc(100svh - 10.5rem), 900px);
    overflow: hidden;
    isolation: isolate;
  }

  .v8-hero-inner {
    position: relative;
    z-index: 3;
    display: flex;
    min-height: inherit;
    align-items: center;
    padding-block: clamp(4.25rem, 8vw, 7.5rem);
  }

  .v8-hero-copy {
    width: min(100%, 720px);
  }

  .v8-hero-label {
    margin: 0 0 1.25rem;
    color: var(--color-cobalt-text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .v8-hero-title {
    max-width: 720px;
    margin: 0;
    font-size: clamp(3.8rem, 5.1vw, 5.5rem);
    line-height: 0.93;
    letter-spacing: -0.062em;
  }

  .v8-hero-title strong {
    color: var(--color-cobalt);
    font-weight: inherit;
  }

  .v8-hero-intro {
    max-width: 620px;
    margin: 2rem 0 0;
    color: #c7cad3;
    font-size: clamp(1rem, 1.4vw, 1.22rem);
    line-height: 1.66;
  }

  .v8-hero-actions {
    margin-top: 2rem;
  }

  .v8-hero-proof {
    max-width: 660px;
    margin-top: 2rem;
  }

  .v8-hero-contact {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    margin-top: 1.35rem;
    color: var(--color-paper-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    transition: color 180ms ease;
  }

  .v8-hero-contact span {
    color: var(--color-signal);
  }

  .v8-hero-contact:hover,
  .v8-hero-contact:focus-visible {
    color: var(--color-paper);
  }

  .v8-hero-media {
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: hidden;
    background: #050608;
  }

  .v8-hero-media::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(5 6 8 / 0.99) 0%, rgb(5 6 8 / 0.9) 29%, rgb(5 6 8 / 0.42) 48%, rgb(5 6 8 / 0.04) 72%),
      linear-gradient(0deg, rgb(5 6 8 / 0.82) 0%, transparent 30%);
    content: "";
  }

  .v8-hero-media img {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
    max-width: none;
    height: 100%;
    object-fit: contain;
    object-position: right center;
  }

  .v8-hero-media > p {
    position: absolute;
    z-index: 2;
    right: clamp(1.4rem, 4.4vw, 4.5rem);
    bottom: 1.4rem;
    margin: 0;
    color: rgb(244 246 251 / 0.72);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .v8-hero-signal {
    position: absolute;
    z-index: 2;
    top: 14%;
    bottom: 16%;
    left: 51%;
    width: 1px;
    background: linear-gradient(transparent, rgb(40 81 255 / 0.8) 25%, rgb(40 81 255 / 0.15) 85%, transparent);
  }

  .v8-hero-signal::before,
  .v8-hero-signal::after {
    position: absolute;
    left: -4px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    content: "";
  }

  .v8-hero-signal::before {
    top: 10%;
    background: var(--color-cobalt);
    box-shadow: 0 0 22px rgb(40 81 255 / 0.8);
  }

  .v8-hero-signal::after {
    bottom: 8%;
    background: var(--color-signal);
    box-shadow: 0 0 22px rgb(255 96 77 / 0.65);
  }

  @media (min-width: 901px) and (max-height: 950px) {
    .v8-hero-inner {
      padding-block: 3rem;
    }

    .v8-hero-label {
      margin-bottom: 1rem;
    }

    .v8-hero-intro,
    .v8-hero-actions,
    .v8-hero-proof {
      margin-top: 1.5rem;
    }

    .v8-hero-contact {
      margin-top: 1rem;
    }
  }

  @media (max-width: 900px) {
    .v8-hero-stage {
      min-height: 0;
      overflow: hidden;
    }

    .v8-hero-inner {
      min-height: 0;
      align-items: flex-start;
      padding-top: 4rem;
      padding-bottom: 4.5rem;
    }

    .v8-hero-copy {
      width: min(100%, 660px);
    }

    .v8-hero-title {
      font-size: clamp(3.8rem, 12vw, 6rem);
    }

    .v8-hero-media {
      position: relative;
      z-index: 1;
      height: min(118vw, 520px);
      margin-top: -2.5rem;
    }

    .v8-hero-media img {
      right: -11%;
    }

    .v8-hero-media::after {
      background:
        linear-gradient(180deg, #050608 0%, transparent 25%, transparent 78%, rgb(5 6 8 / 0.8) 100%),
        linear-gradient(90deg, rgb(5 6 8 / 0.92) 0%, rgb(5 6 8 / 0.22) 48%, transparent 80%);
    }

    .v8-hero-signal {
      left: 22%;
    }
  }

  @media (max-width: 520px) {
    .v8-hero-inner {
      padding-top: 3rem;
      padding-bottom: 3.5rem;
    }

    .v8-hero-title {
      font-size: clamp(3.3rem, 15vw, 4.8rem);
      line-height: 0.92;
    }

    .v8-hero-intro {
      margin-top: 1.5rem;
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .v8-hero-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .v8-hero-actions .studio-button {
      width: 100%;
    }

    .v8-hero-proof span:nth-of-type(2),
    .v8-hero-proof span:nth-of-type(4),
    .v8-hero-proof i:nth-of-type(1),
    .v8-hero-proof i:nth-of-type(3) {
      display: none;
    }

    .v8-hero-media {
      height: min(128vw, 500px);
      margin-top: -1.5rem;
    }

    .v8-hero-media img {
      right: -25%;
    }

    .v8-hero-media > p {
      right: 1rem;
      bottom: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .production-ticker-track {
      animation: none;
    }
  }
</style>
