---
import { getBookingHref, getCalAttrs } from "../utils/booking";

interface Props {
  prompt: string;
  label?: string;
  href?: string;
  external?: boolean;
  session?: string;
  placement?: string;
}

const {
  prompt,
  label = "Tell Keith about your task",
  href = getBookingHref(),
  external = false,
  session,
  placement,
} = Astro.props;
const calAttrs = session ? {} : getCalAttrs();
---

<div class="hairline mt-20 pt-10 flex flex-col items-center text-center gap-5">
  <p class="serif italic text-[clamp(20px,2vw,26px)] text-paper-dim max-w-[640px] leading-[1.4]">
    {prompt}
  </p>
  <a
    href={href}
    {...calAttrs}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    data-session-booking={session}
    data-session-placement={placement}
    class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] uppercase px-6 py-3 rounded-full border border-cobalt text-cobalt hover:bg-cobalt hover:text-ink transition-colors"
  >
    {label}
    <span aria-hidden="true">→</span>
  </a>
</div>
