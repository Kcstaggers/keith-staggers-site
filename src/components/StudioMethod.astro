---
const stages = [
  {
    number: "01",
    title: "Find repeated work",
    detail: "Name the task, owner, inputs, and finish line before choosing a tool.",
  },
  {
    number: "02",
    title: "Bound the AI job",
    detail: "Decide what AI may draft or sort, and what it may never see or decide.",
  },
  {
    number: "03",
    title: "Keep the human check",
    detail: "Verify facts, context, tone, and the final decision with the accountable person.",
  },
  {
    number: "04",
    title: "Document next use",
    detail: "Save the inputs, prompt pattern, checks, and handoff so the work can repeat.",
  },
];

const examples = [
  {
    problem: "Leadership decision",
    startingPoint: "Notes, constraints, options",
    aiContribution: "Surfaces themes and drafts choices",
    humanDecision: "Leader sets priorities and tradeoffs",
    result: "Decision brief",
  },
  {
    problem: "Team training",
    startingPoint: "Source material and real questions",
    aiContribution: "Builds scenarios and exercises",
    humanDecision: "Expert verifies accuracy and fit",
    result: "Reusable workshop",
  },
  {
    problem: "Creative release",
    startingPoint: "Idea, references, raw media",
    aiContribution: "Develops directions and variations",
    humanDecision: "Creator chooses taste and final cut",
    result: "Finished campaign",
  },
  {
    problem: "Repeated business task",
    startingPoint: "Steps, files, and rules",
    aiContribution: "Maps and handles repeatable work",
    humanDecision: "Owner approves exceptions",
    result: "Tested workflow",
  },
];
---

<section id="method" class="studio-section studio-method scroll-mt-24" aria-labelledby="studio-method-title">
  <div class="studio-shell">
    <header class="studio-method-head">
      <div>
        <p class="studio-kicker">A method you can use now</p>
        <h2 id="studio-method-title" class="studio-display studio-section-title">
          Useful AI work has<br /><strong>four parts</strong><span class="text-signal">.</span>
        </h2>
      </div>
      <p>
        If a workflow cannot survive these four steps, it is not ready for the work. This is the method behind the product, training, and builds.
      </p>
    </header>

    <ol class="method-loop" aria-label="Four-part AI workflow method">
      {stages.map((stage, index) => (
        <li class="method-node" style={`--method-delay: ${index * 120}ms`}>
          <span>{stage.number}</span>
          <h3>{stage.title}</h3>
          <p>{stage.detail}</p>
        </li>
      ))}
    </ol>

    <p class="method-value-line">
      <span>This is what you are buying</span>
      Not more prompts. A loop your team can use again.
    </p>

    <div class="method-examples" aria-label="Examples of the method across different kinds of work">
      <div class="method-example-row method-example-head" aria-hidden="true">
        <span>Problem</span><span>What you have</span><span>AI contributes</span><span>Human decides</span><span>Useful result</span>
      </div>
      {examples.map((example) => (
        <div class="method-example-row">
          <b>{example.problem}</b>
          <span data-label="What you have">{example.startingPoint}</span>
          <span data-label="AI contributes">{example.aiContribution}</span>
          <span data-label="Human decides">{example.humanDecision}</span>
          <span data-label="Useful result">{example.result}</span>
        </div>
      ))}
    </div>
  </div>
</section>
