---
const stages = [
  {
    number: "01",
    title: "Choose one real task",
    detail: "Start with a task that wastes time, gets repeated, or keeps getting stuck.",
  },
  {
    number: "02",
    title: "Decide what AI may do",
    detail: "Write down what AI can help with and what a person must still check or decide.",
  },
  {
    number: "03",
    title: "Build and test it",
    detail: "Create the simplest useful version and test normal cases, mistakes, and failures.",
  },
  {
    number: "04",
    title: "Teach the person using it",
    detail: "Give the team clear instructions, examples, and a way to work without Keith.",
  },
];

const examples = [
  {
    problem: "Weekly reports",
    startingPoint: "Facts scattered across notes and files",
    aiContribution: "Organizes information and drafts repeated sections",
    humanDecision: "A manager checks facts and approves the report",
    result: "A faster report process the team can repeat",
  },
  {
    problem: "Follow-up messages",
    startingPoint: "The same messages rewritten each week",
    aiContribution: "Creates a first draft from approved information",
    humanDecision: "A person reviews, edits, and sends it",
    result: "Faster, more consistent follow-up",
  },
  {
    problem: "Team training",
    startingPoint: "Presentations that do not change daily work",
    aiContribution: "Creates practice examples around familiar tasks",
    humanDecision: "The leader checks accuracy and workplace fit",
    result: "A practical session and reusable guide",
  },
  {
    problem: "Content and projects",
    startingPoint: "Too many drafts and unfinished ideas",
    aiContribution: "Organizes the source and prepares useful versions",
    humanDecision: "The creator chooses, edits, and publishes",
    result: "Finished work that can be reused",
  },
];
---

<section id="method" class="studio-section studio-method scroll-mt-24" aria-labelledby="studio-method-title">
  <div class="studio-shell">
    <header class="studio-method-head">
      <div>
        <p class="studio-kicker">Concrete examples</p>
        <h2 id="studio-method-title" class="studio-display studio-section-title">
          What can Keith<br /><strong>make easier</strong><span class="text-signal">?</span>
        </h2>
      </div>
      <p>
        Start with a familiar task, not an AI tool. These examples show the kind of help Keith provides and where a person stays responsible.
      </p>
    </header>

    <div class="method-examples" aria-label="Examples of work Keith can make easier">
      <div class="method-example-row method-example-head" aria-hidden="true">
        <span>Task</span><span>What happens now</span><span>How AI helps</span><span>What a person checks</span><span>Result</span>
      </div>
      {examples.map((example) => (
        <div class="method-example-row">
          <b>{example.problem}</b>
          <span data-label="What happens now">{example.startingPoint}</span>
          <span data-label="How AI helps">{example.aiContribution}</span>
          <span data-label="What a person checks">{example.humanDecision}</span>
          <span data-label="Result">{example.result}</span>
        </div>
      ))}
    </div>

    <p class="method-value-line">
      <span>How Keith works</span>
      Make the task easier without hiding who is responsible.
    </p>

    <ol class="method-loop" aria-label="Keith's four-step approach">
      {stages.map((stage, index) => (
        <li class="method-node" style={`--method-delay: ${index * 120}ms`}>
          <span>{stage.number}</span>
          <h3>{stage.title}</h3>
          <p>{stage.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
