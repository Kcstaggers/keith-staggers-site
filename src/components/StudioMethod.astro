---
const stages = [
  {
    number: "01",
    title: "Name the real job",
    detail: "Start with the outcome, the person responsible, and what finished means.",
  },
  {
    number: "02",
    title: "Set the boundaries",
    detail: "Decide what AI may help with and what a person must still check or approve.",
  },
  {
    number: "03",
    title: "Build and test",
    detail: "Create the simplest useful version and test normal cases, mistakes, and failures.",
  },
  {
    number: "04",
    title: "Teach and hand off",
    detail: "Give the owner clear instructions, examples, and a manual way to finish the work.",
  },
];

const examples = [
  { number: "01", title: "Weekly reports", flow: "Scattered facts → organized draft → manager approval" },
  { number: "02", title: "Follow-up messages", flow: "Repeated rewriting → useful first draft → person sends" },
  { number: "03", title: "Team training", flow: "Generic slides → familiar practice → leader checks" },
  { number: "04", title: "Unfinished projects", flow: "Too many drafts → clear production steps → creator releases" },
];
---

<section id="method" class="studio-section studio-method scroll-mt-24" aria-labelledby="studio-method-title">
  <div class="studio-shell">
    <header class="v8-method-head">
      <p class="studio-kicker">Familiar work, clear responsibility</p>
      <h2 id="studio-method-title" class="studio-display studio-section-title">
        What can Keith<br /><strong>make easier</strong><span class="text-signal">?</span>
      </h2>
    </header>

    <div class="v8-method-examples" aria-label="Examples of work Keith can make easier">
      {examples.map((example) => (
        <article>
          <span>{example.number}</span>
          <h3>{example.title}</h3>
          <p>{example.flow}</p>
        </article>
      ))}
    </div>

    <p class="method-value-line">
      <span>How Keith works</span>
      Make the task easier without hiding who is responsible.
    </p>

    <ol class="method-loop" aria-label="Keith's four-step approach">
      {stages.map((stage, index) => (
        <li class="method-node" style={`--method-delay: ${index * 120}ms`}>
          <span>{stage.number}</span>
          <h3>{stage.title}</h3>
          <p>{stage.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .v8-method-head {
    max-width: 880px;
  }

  .v8-method-head .studio-section-title {
    margin-top: 0.9rem;
  }

  .v8-method-examples {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    border: 1px solid var(--color-rule);
    background: var(--color-rule);
  }

  .v8-method-examples article {
    position: relative;
    min-height: 205px;
    padding: 1.5rem;
    overflow: hidden;
    background: rgb(5 6 8 / 0.94);
  }

  .v8-method-examples article::after {
    position: absolute;
    right: -2.5rem;
    bottom: -3.75rem;
    width: 8rem;
    height: 8rem;
    border: 1px solid rgb(40 81 255 / 0.28);
    border-radius: 50%;
    content: "";
  }

  .v8-method-examples span {
    color: var(--color-cobalt-text);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .v8-method-examples h3 {
    margin-top: 2.7rem;
    font-size: clamp(1.25rem, 1.8vw, 1.7rem);
    font-weight: 620;
    letter-spacing: -0.035em;
  }

  .v8-method-examples p {
    margin-top: 0.8rem;
    color: var(--color-paper-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .method-value-line {
    margin-top: 1px;
  }

  .method-loop {
    margin-top: 1px;
  }

  @media (max-width: 900px) {
    .v8-method-examples {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .v8-method-examples {
      grid-template-columns: minmax(0, 1fr);
    }

    .v8-method-examples article {
      min-height: 170px;
    }

    .v8-method-examples h3 {
      margin-top: 2rem;
    }
  }
</style>
