---
import { featuredBook, liveEditionsFor } from "../data/books";

const kindle = liveEditionsFor(featuredBook).find((edition) => edition.format === "Kindle");
const bookPath = `/books/${featuredBook.slug}/`;
---

<section id="book" class="studio-section v8-book scroll-mt-24" aria-labelledby="v8-book-title">
  <div class="studio-shell v8-book-grid">
    <div class="v8-book-object">
      <span class="v8-book-orbit v8-book-orbit--one"></span>
      <span class="v8-book-orbit v8-book-orbit--two"></span>
      <img
        src={`/media/book-${featuredBook.slug}.webp`}
        alt={`${featuredBook.title} by Keith Staggers book cover`}
        width={featuredBook.coverWidth}
        height={featuredBook.coverHeight}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="v8-book-copy">
      <p class="studio-kicker">New practical AI book</p>
      <h2 id="v8-book-title" class="studio-display studio-section-title">
        Build the workflow.<br /><strong>Keep the judgment.</strong>
      </h2>
      <p class="v8-book-subtitle">{featuredBook.subtitle}</p>
      <p class="studio-section-lede">
        A practical field guide for turning scattered AI chats into a work system with clear sources, human approval, testing, proof, and a way to recover when something fails.
      </p>

      <ul class="v8-book-lessons">
        <li>Organize context so the work can survive a new chat or tool.</li>
        <li>Keep a person in control of money, identity, commitments, and judgment.</li>
        <li>Test normal cases, failures, recovery, and the manual fallback.</li>
      </ul>

      <div class="v8-book-actions">
        {kindle && (
          <a
            href={kindle.amazonUrl}
            class="studio-button studio-button--primary"
            target="_blank"
            rel="noopener noreferrer"
            data-amazon-book={featuredBook.slug}
            data-amazon-format="kindle"
            data-amazon-placement="homepage-commerce"
          >
            Buy the Kindle · ${kindle.priceUsd}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
          </a>
        )}
        <a href={bookPath} class="studio-button studio-button--secondary">
          See what is inside
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        </a>
      </div>

      <a href="/workflow-book/" class="v8-book-companion">Already reading? Get the free companion templates <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .v8-book {
    overflow: hidden;
    background:
      radial-gradient(circle at 24% 50%, rgb(40 81 255 / 0.18), transparent 23rem),
      linear-gradient(180deg, #06080d, #050608);
  }

  .v8-book-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: center;
  }

  .v8-book-object {
    position: relative;
    display: grid;
    min-height: 590px;
    place-items: center;
    perspective: 1100px;
  }

  .v8-book-object::before {
    position: absolute;
    inset: 20% 2% 11%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(40 81 255 / 0.34), transparent 68%);
    content: "";
    filter: blur(20px);
  }

  .v8-book-object > img {
    position: relative;
    z-index: 2;
    width: min(76%, 330px);
  }

  .v8-book-object img {
    max-width: 100%;
    border: 1px solid rgb(244 246 251 / 0.2);
    box-shadow: 34px 42px 78px rgb(0 0 0 / 0.68);
    transform: rotateY(7deg) rotateZ(-1.5deg);
    transition: transform 420ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .v8-book-object:hover img {
    transform: rotateY(1deg) rotateZ(0) translateY(-8px);
  }

  .v8-book-orbit {
    position: absolute;
    border: 1px solid rgb(40 81 255 / 0.46);
    border-radius: 50%;
  }

  .v8-book-orbit--one {
    inset: 15% -5% 14% 0;
    transform: rotate(-18deg) scaleY(0.52);
  }

  .v8-book-orbit--two {
    inset: 25% -8% 6% 8%;
    border-color: rgb(255 96 77 / 0.3);
    transform: rotate(19deg) scaleY(0.42);
  }

  .v8-book-copy {
    position: relative;
    z-index: 2;
  }

  .v8-book-copy h2 strong {
    color: var(--color-cobalt);
    font-weight: inherit;
  }

  .v8-book-subtitle {
    max-width: 660px;
    margin: 1.25rem 0 0;
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .v8-book-copy .studio-section-lede {
    max-width: 690px;
    margin-top: 1.75rem;
  }

  .v8-book-lessons {
    display: grid;
    gap: 0.8rem;
    max-width: 680px;
    margin-top: 1.75rem;
    color: var(--color-paper-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .v8-book-lessons li {
    position: relative;
    padding-left: 1.5rem;
  }

  .v8-book-lessons li::before {
    position: absolute;
    left: 0;
    color: var(--color-signal);
    content: "↳";
  }

  .v8-book-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .v8-book-companion {
    display: inline-flex;
    gap: 0.75rem;
    margin-top: 1.4rem;
    color: var(--color-paper-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    transition: color 180ms ease;
  }

  .v8-book-companion span {
    color: var(--color-cobalt-text);
  }

  .v8-book-companion:hover,
  .v8-book-companion:focus-visible {
    color: var(--color-paper);
  }

  @media (max-width: 900px) {
    .v8-book-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .v8-book-object {
      min-height: 480px;
    }

    .v8-book-object > img {
      width: min(62%, 310px);
    }
  }

  @media (max-width: 520px) {
    .v8-book-object {
      min-height: 390px;
    }

    .v8-book-object > img {
      width: min(68%, 270px);
    }

    .v8-book-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .v8-book-actions .studio-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .v8-book-object img {
      transition: none;
    }
  }
</style>
