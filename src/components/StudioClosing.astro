---
import { site } from "../data/site";
import OrbitalPortrait from "./OrbitalPortrait.astro";

const ctaHref = site.booking.intakePath;
---

<section class="studio-closing" aria-labelledby="studio-closing-title">
  <div class="studio-shell studio-closing-grid">
    <h2 id="studio-closing-title" class="studio-display">What is slowing<br />your team <strong>down</strong><span class="text-signal">?</span></h2>
    <div class="studio-closing-portrait"><OrbitalPortrait /></div>
    <div class="studio-closing-action">
      <p>Tell me about the task or project. I will recommend the simplest useful next step, even when the answer is not to use AI.</p>
      <a
        href={ctaHref}
        class="studio-button studio-button--primary"
      >
        Tell me what you need help with
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
      </a>
      <a href="/workflow-readiness/" class="studio-email">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
        See if your task is ready for AI
      </a>
    </div>
  </div>
</section>
